model Payment {
  id                       String                  @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id])
  loanId                   String
  amount                   Int
  paymentMethod            PaymentMethod           @default(EFT)
  reference                String?
  notes                    String?
  capturedBy               String?
  allocationStatus         PaymentAllocationStatus @default(ALLOCATED)
  reconciliationReason     String?
  reconciledAt             DateTime?
  reconciledById           String?
  reconciliationReference  String?
  // Date the money actually reached us, as distinct from createdAt (when staff
  // captured it). NCA s125(2)(b) charges interest only up to the settlement
  // date, so accrual runs to THIS.
  //
  // NOT NULL with a default, deliberately. A nullable value date is not merely
  // untidy: PostgreSQL sorts `ORDER BY col DESC` as NULLS FIRST, so a single
  // unset row silently becomes "the newest receipt" for anything that orders by
  // it — which is how an earlier attempt read the wrong receipt on every loan.
  // A default makes that state unreachable no matter which writer forgets.
  receivedAt               DateTime                @default(now())
  // Set on the refund-due half of an over-payment, pointing at the receipt it
  // was split from. Without this link the two halves cannot be re-joined, and
  // the idempotency replay check cannot tell a retried R2 500.00 capture from a
  // different request that happens to have collected R2 425.67.
  parentPaymentId          String?
  reversed                 Boolean                 @default(false)
  reversedAt               DateTime?
  reversedById             String?
  reversalReason           String?
  idempotencyKey           String?                 @db.VarChar(128)
  // The part of `amount` that paid default charges (s126(3): default interest,
  // then fees and charges, then the schedule). Rewritten by syncLoanCharges;
  // Loan.totalPaid counts only amount minus these two.
  defaultInterestAllocated Int                     @default(0)
  chargeFeesAllocated      Int                     @default(0)
  createdAt                DateTime                @default(now())
  loan                     Loan                    @relation(fields: [loanId], references: [id])
  parentPayment            Payment?                @relation("PaymentOverpayment", fields: [parentPaymentId], references: [id])
  excessPayments           Payment[]               @relation("PaymentOverpayment")
  surrenderProceeds        SurrenderRequest[]      @relation("SurrenderProceedsPayment")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, allocationStatus])
  @@index([parentPaymentId])
  @@index([loanId, receivedAt])
}

enum PaymentAllocationStatus {
  ALLOCATED
  UNAPPLIED
  REFUNDED
}

enum PaymentMethod {
  EFT
  CASH
  DEBIT_ORDER
  CARD
  // Non-cash credit closing a sub-R1 residue (lib/loan/small-balance-waiver.ts).
  // Never cash collected: see lib/payments/waiver.ts.
  WAIVER
}

