  clientId                                String?
  // Exactly one of clientId / entityId (CHECK LoanApplication_borrower_xor).
  entityId                                String?
  // Authorised director/member/trustee/signatory who performs the NCA document
  // ceremony for an entity borrower. Null for natural-person applications.
  ncaRepresentativeClientId               String?
  // NCA classification snapshot (DESIGN D5), written by
  // lib/asset-finance/classification.ts; an override goes through
  // NcaRegimeOverride. Null until classified.
  ncaRegime                               NcaRegime?
  ncaClassificationRule                   String?
  ncaClassificationInputs                 Json?
  ncaClassificationEvidenceIds            String[]                   @default([])
  ncaClassifiedAt                         DateTime?
  ncaClassifiedById                       String?
  productId                               String
  branchId                                String?
  branch                                  Branch?                    @relation(fields: [branchId], references: [id])
  appliedAmount                           Int
  appliedTermDays                         Int
  purpose                                 String?
  status                                  AppStatus                  @default(DRAFT)
  assignedToId                            String?
  approvedById                            String?
  affordabilityResult                     Json?
  decisionReason                          String?
  // Coarse, for internal reporting. NOT the NCA s.62 statement of reasons.
  declineCategory                         DeclineCategory?
  loanPurposeCategory                     LoanPurposeCategory?
  productRecommendationNote               String?
  existingDebtObligations                 Json?
  totalExistingDebt                       Int?
  netDisposableIncome                     Int?
  affordabilityNDI                        Int?
  recklessLendingAssessed                 Boolean                    @default(false)
  recklessLendingAssessedById             String?
  recklessLendingAssessedAt               DateTime?
  recklessLendingNote                     String?
  bureauOverrideReason                    String?
  bureauOverrideById                      String?
  bureauOverrideBy                        User?                      @relation("BureauOverrideBy", fields: [bureauOverrideById], references: [id])
  bureauOverrideAt                        DateTime?
  // Identifies the current review cycle. Async bureau responses must carry
  // this exact value or they are stale evidence for a prior assessment.
  bureauReviewGeneration                  String?
  pasqAcknowledgedAt                      DateTime?
  pasqAcknowledgedBy                      String?
  pasqAcknowledgedSha256                  String?
  pasqVersion                             String?
  pasqGeneratedAt                         DateTime?
  pasqDocumentId                          String?
  pasqDocumentSha256                      String?
  pasqEvidence                            Json?
  pasqEvidenceSha256                      String?
  approvedPasqDocumentSha256              String?
  clientAffordabilityDeclaredAt           DateTime?
  agreementType                           AgreementType?
  // Consumer's NCA s.101 initiation-fee payment option, captured at agreement
  // generation. DEFERRED (default) = full advance, fee interest-free in the
  // schedule; UPFRONT = fee deducted from the advance.
  initiationFeePayment                    InitiationFeePayment       @default(DEFERRED)
  creditLifeElection                      CreditLifeElection?
  creditLifeProductId                     String?
  creditLifeProductName                   String?
  creditLifeInsurerId                     String?
  creditLifeInsurerName                   String?
  creditLifeMonthlyPremiumCents           Int?
  creditLifeDisclosureVersion             String?
  creditLifeDisclosureSha256              String?
  creditLifeDisclosureAcknowledgedAt      DateTime?
  creditLifeDisclosureAcknowledgedBy      String?
  incomeVerificationMethod                String?
  incomeVerifiedAt                        DateTime?
  incomeVerifiedById                      String?
  agreementGeneratedAt                    DateTime?
  agreementDocumentId                     String?
  agreementDocumentSha256                 String?
  agreementSignedAt                       DateTime?
  agreementSignedMethod                   String?
  agreementSignedByIp                     String?
  agreementSignedByUserId                 String?
  agreementSignatureData                  String? // base64 PNG data URL (drawn) or typed name — the e-signature artifact
  agreementCountersignedAt                DateTime?
  agreementCountersignedById              String?
  agreementCountersignedByName            String?
  agreementCountersignedByEmail           String?
  agreementCountersignatureData           String?
  agreementCountersignatureSha256         String?
  agreementCountersignatureEnvelopeSha256 String?
  agreementCountersignedDocumentSha256    String?
  /// The EXECUTED agreement: the artifact that actually carries both
  /// signatures, minted once inside the countersign transaction. Distinct from
  /// agreementDocumentId, which stays bound to the UNSIGNED document the
