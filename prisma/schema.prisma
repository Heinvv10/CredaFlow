model AssetFinanceAffordabilityAssessment {
  id                             String           @id @default(cuid())
  tenantId                       String
  dealId                         String           @unique
  deal                           AssetFinanceDeal @relation(fields: [tenantId, dealId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  verifiedBusinessIncomeCents    BigInt
  businessNdiBeforeProposedCents BigInt
  personalNdiCents               BigInt?
  proposedInstalmentCents        BigInt
  combinedNdiAfterProposedCents  BigInt
  affordable                     Boolean
  recklessLendingNote            String
  assessedById                   String
  assessedBy                     User             @relation(fields: [tenantId, assessedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  assessedAt                     DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  @@unique([tenantId, dealId])
}

enum DealSignerRole {
  AUTHORISED_SIGNATORY
  SURETY
}

enum DealDocumentKind {
  AGREEMENT
  SURETYSHIP
  RESOLUTION
}

enum SignatureMethod {
  E_SIGN
  WET_INK
}

// One required signature on one deal document. The required set is derived
// from the entity's authorised signatories (agreement, resolution) and the
// deal's sureties (one suretyship each); lib/asset-finance/signing.ts.
// The document is rendered once when the deal's documents are prepared and
// stored (lib/storage) at documentStoragePath; documentSha256 binds those
// bytes. Signing also re-renders it and refuses if the deal has changed since.
// Hand-written guards: guardDealSigner, guardAssetDealContract.
model DealSigner {
  id                  String           @id @default(cuid())
  tenantId            String
  dealId              String
  deal                AssetFinanceDeal @relation(fields: [tenantId, dealId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  clientId            String
  client              Client           @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role                DealSignerRole
  document            DealDocumentKind
  documentSha256      String?
  documentStoragePath String?
  method              SignatureMethod?
  signedAt            DateTime?
  signatureData       String?
  signatureSha256     String?
  signedByIp          String?
  // Wet ink: the scan (an EntityDocument SIGNED_* of this deal), who uploaded
  // it and when; a different user confirms it (CHECK DealSigner_wet_ink_four_eyes).
  scanDocumentId      String?
  scanDocument        EntityDocument?  @relation("DealSignerScan", fields: [tenantId, scanDocumentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  scanUploadedById    String?
  scanUploadedAt      DateTime?
  confirmedById       String?
  confirmedAt         DateTime?
  createdAt           DateTime         @default(now())

  @@unique([dealId, clientId, document])
  @@index([tenantId, clientId])
}

enum PayoutChecklistItemKind {
  SIGNED_AGREEMENT
  SIGNED_SURETYSHIPS
  SIGNED_RESOLUTION
  SUPPLIER_INVOICE_MATCHES_ASSET
  SUPPLIER_BANK_VERIFIED
  INSURANCE_NOTES_LENDER
  TRACKER_CONFIRMED
  DELIVERY_AND_ACCEPTANCE
  NATIS_TITLEHOLDER
}

// One payout-gate item of a CONTRACTED deal (DESIGN D8). The rows are created
// when the deal is contracted (lib/asset-finance/payout-checklist.ts holds the
// requirement table; payoutChecklistRequiredKinds is its SQL twin). Staff
// confirm each one with its evidence; a confirmed item is immutable, and the
// Payout insert is refused unless every required item is confirmed
// (hand-written guards: guardPayoutChecklistItem, guardPayout).
model PayoutChecklistItem {
  id                 String                  @id @default(cuid())
  tenantId           String
  dealId             String
  deal               AssetFinanceDeal        @relation(fields: [tenantId, dealId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  item               PayoutChecklistItemKind
  required           Boolean                 @default(true)
  confirmedById      String?
  confirmedBy        User?                   @relation("PayoutChecklistConfirmedBy", fields: [tenantId, confirmedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  confirmedAt        DateTime?
  evidenceDocumentId String?
  evidenceDocument   EntityDocument?         @relation("PayoutChecklistEvidence", fields: [tenantId, evidenceDocumentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // SUPPLIER_INVOICE_MATCHES_ASSET: the serial or VIN typed off the invoice, normalised.
  attestedIdentifier String?
  note               String?

  @@unique([dealId, item])
}

enum PayoutStatus {
  PENDING_APPROVAL
  APPROVED
  RELEASED
  CANCELLED
}

// The supplier payout for a deal: the asset's cash price incl. VAT less the
// deposit and the trade-in, i.e. what the supplier is still owed (financed
// fees stay with the lender). The DB refuses it unless the deal is
// CONTRACTED, every required checklist item is confirmed and the account is
// the supplier's APPROVED one; at or above the tenant threshold
// (dualApprovalRequired, set by the insert trigger) a second, different
// user approves it, otherwise the creator's creation is the approval. It is
// RELEASED by booking and then never changes (guardPayout, CHECKs).
model Payout {
  id                    String              @id @default(cuid())
  tenantId              String
  dealId                String              @unique
  deal                  AssetFinanceDeal    @relation(fields: [tenantId, dealId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  supplierBankAccountId String
  supplierBankAccount   SupplierBankAccount @relation(fields: [tenantId, supplierBankAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  amountCents           Int
  status                PayoutStatus        @default(PENDING_APPROVAL)
  dualApprovalRequired  Boolean             @default(false)
  createdById           String
  createdBy             User                @relation("PayoutsCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedById          String?
  approvedBy            User?               @relation("PayoutsApprovedBy", fields: [tenantId, approvedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedAt            DateTime?
  releasedAt            DateTime?
  releasedById          String?
  releasedBy            User?               @relation("PayoutsReleasedBy", fields: [tenantId, releasedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  cancelledAt           DateTime?
  cancelledById         String?
  cancelledBy           User?               @relation("PayoutsCancelledBy", fields: [tenantId, cancelledById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt             DateTime            @default(now())

  @@unique([tenantId, dealId])
}

enum RentalTiming {
  ADVANCE
  ARREARS
}

enum MaintenanceRiskModel {
  LENDER_RISK
  LESSEE_SETTLED
}

enum UsageUnit {
  HOURS
  KM
}

// One row per rental of an operating or full-maintenance lease, written at
// booking beside its RepaymentSchedule row (lib/asset-finance/lease-booking.ts).
// The amounts are fixed once written, except by a reprice before the rental is
// invoiced; taxInvoiceId is set once, when the rental's tax invoice is issued
// (lib/asset-finance/lease-invoices.ts). Migration 20261014090000.
model LeaseRental {
  id                      String            @id @default(cuid())
  tenantId                String
  tenant                  Tenant            @relation(fields: [tenantId], references: [id])
  loanId                  String
  loan                    Loan              @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  scheduleId              String            @unique
  schedule                RepaymentSchedule @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  periodNo                Int
  dueDate                 DateTime          @db.Date
  rentalExclVatCents      Int
  maintenanceExclVatCents Int
  vatCents                Int
  totalCents              Int
  // The VAT rate the amounts were computed at (DECIMAL(6,4), 0.1500 = 15%).
  vatRate                 Decimal           @db.Decimal(6, 4)
  taxInvoiceId            String?           @unique
  taxInvoice              TaxInvoice?       @relation(fields: [tenantId, taxInvoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt               DateTime          @default(now())

  @@unique([tenantId, id])
  @@unique([tenantId, scheduleId])
  @@unique([tenantId, taxInvoiceId])
  @@unique([loanId, periodNo])
  @@index([tenantId, dueDate])
}
