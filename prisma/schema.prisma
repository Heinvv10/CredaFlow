  @@index([tenantId])
}

// A person's role in an entity. One row per (entity, client, role): the same
// person can be a director, a surety and a beneficial owner.
model EntityRelationship {
  id           String         @id @default(cuid())
  tenantId     String
  entityId     String
  entity       BusinessEntity @relation(fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  clientId     String
  client       Client         @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role         EntityRole
  // Trustees only (CHECK EntityRelationship_trustee_kind). JURISTIC: the
  // Client represents a juristic trustee (a company acting as trustee).
  trusteeKind  TrusteeKind?
  ownershipPct Decimal?       @db.Decimal(5, 2)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([entityId, clientId, role])
  @@index([tenantId, clientId])
}

// An override of an application's NCA classification. NCA → NON_NCA needs a
// second, different user with credit permission to approve it (DESIGN D5);
// a classifier result of NON_NCA is recorded as such a request. Immutable once
// decided, never deleted (trigger guardNcaRegimeOverrideLifecycle).
model NcaRegimeOverride {
  id                         String            @id @default(cuid())
  tenantId                   String
  applicationId              String
  application                LoanApplication   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  fromRegime                 NcaRegime
  toRegime                   NcaRegime
  reason                     String
  source                     NcaOverrideSource
  status                     NcaOverrideStatus @default(PENDING)
  requestedById              String
  requestedBy                User              @relation("NcaOverridesRequested", fields: [tenantId, requestedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedById                String?
  decidedBy                  User?             @relation("NcaOverridesDecided", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedAt                  DateTime?
  // The application as it stood when the override was requested. An approval
  // to NON_NCA authorises the change for exactly this borrower, amount,
  // product and classification (rule, and the ncaClassifiedAt of the run the
  // approver saw): guardLoanApplicationNcaRegime refuses to spend it on an
  // application that no longer matches, so a re-classification makes it
  // stale. Required for toRegime NON_NCA (CHECK NcaRegimeOverride_non_nca_snapshot).
  approvedEntityId           String?
  approvedAppliedAmount      Int?
  approvedProductId          String?
  approvedClassificationRule String?
  approvedClassifiedAt       DateTime?
  decisionNote               String?
  // Set by trigger guardLoanApplicationNcaRegime when it spends this approval
  // on the NCA → NON_NCA change it authorises: one approval, one change.
  appliedAt                  DateTime?
  createdAt                  DateTime          @default(now())

  @@index([tenantId, applicationId])
}

// How a product's initiation fee is PRICED, as opposed to how it is capped.
//
// FLAT_PCT prices the fee as `initiationFeePct` x principal. That is a
// commercial setting, and the statutory ceiling still applies on top of it —
// which is the problem it caused: the marketing table printed the configured
// percentage while the engine charged the lower statutory figure, so a R3,000
// Micro Loan advertised 15% (R450) and billed R419.75.
//
// NCA_REG42 prices the fee ON the Reg 42 schedule itself, so the configured
// price and the charged price are the same number at every principal, and the
// product config no longer claims a percentage nothing honours. The schedule is
// NOT duplicated into the product row — it is read from lib/loan/nca-fee-cap.ts,
// which stays the single place legal verifies. `initiationFeeMax` still applies
// as a COMMERCIAL cap below the statutory one (Micro Loan charges at most
// R1,000 where the statute would allow R1,207.50), and `initiationFeePct` is
// unused for pricing.
enum InitiationFeeModel {
  FLAT_PCT
  NCA_REG42
}

// The consumer's NCA s.101 option for paying the initiation fee on an
// unsecured / short-term loan. The fee is INTEREST-FREE in both cases (NCR
// Circular 15 of 2016) — never folded into the interest-bearing principal.
enum InitiationFeePayment {
  DEFERRED // full principal advanced; fee collected interest-free via the schedule (instalment 1)
  UPFRONT // fee deducted from the cash advanced; not collected through the schedule
}

enum CreditLifeElection {
  ACCEPTED
  DECLINED
}

model LoanApplication {
  id                                      String                     @id @default(cuid())
  tenantId                                String
