model AutomationPause {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  ruleId      String
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  createdById String
  createdAt   DateTime       @default(now())

  @@unique([ruleId, entityId])
  @@index([tenantId, entityId])
}

model AutomationLog {
  id            String         @id @default(cuid())
  ruleId        String
  rule          AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  entityType    String
  entityId      String
  result        String
  error         String?
  // Stable trigger occurrence used by outbound automation idempotency. A
  // manual replay reuses this value so uncertain provider outcomes can never
  // be converted into a second Message reservation. Nullable for historical
  // logs written before occurrence-aware delivery.
  occurrenceKey String?        @db.VarChar(128)
  // Replay evidence for SEND_WA. `dispatchPhase` distinguishes a failure
  // before any Message reservation from a provider rejection that may be
  // explicitly re-armed. `messageId` binds the latter to the exact durable
  // reservation. Both are nullable for pre-deployment logs, which therefore
  // fail closed during replay.
  messageId     String?
  dispatchPhase String?        @db.VarChar(32)
  createdAt     DateTime       @default(now())

  @@index([ruleId])
  @@index([tenantId, entityId])
  @@index([tenantId, ruleId, entityId, occurrenceKey], map: "AutomationLog_occurrence_idx")
  @@index([tenantId, messageId], map: "AutomationLog_message_idx")
  @@index([createdAt])
}

/// In-app notification for a staff user — the bell in the dashboard header.
///
/// Deliberately generic rather than task-specific: `type` is a free string
/// (matching AgentTask.type) and entityType/entityId are the same polymorphic
/// deep-link pair AgentTask already uses, so the next producer (an approval
/// waiting, a payment failure) needs no migration.
///
/// This is the IN-APP half of a reminder. The outbound half (WhatsApp/email)
/// is dispatched by the cron and deduped via NotificationThrottle — a row here
/// is a durable inbox item, not a delivery receipt.
model Notification {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  /// Recipient. Cascade: a deleted staff account's unread bell items hold no
  /// audit value — the audit trail lives in AuditLog.
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String?
  /// Deep-link target, e.g. entityType "Lead" + the lead id.
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  /// Backs the unread-count query: (userId, readAt IS NULL).
  @@index([userId, readAt])
  @@index([tenantId, createdAt])
}

model AgentTask {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  assigneeId      String?
  assignee        User?     @relation(fields: [assigneeId], references: [id])
  type            String
  title           String
  description     String?
  entityType      String?
  entityId        String?
  priority        String    @default("MEDIUM")
  status          String    @default("PENDING")
  dueAt           DateTime?
  completedAt     DateTime?
  completedById   String?
  createdByRuleId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([assigneeId, status])
  @@index([tenantId, status])
}

// ─── Phase 9: CRM + Helpdesk ──────────────────────────────────────────────────
//
// Sprint S1, migration step 1a (additive). Everything in this section is new
// to the schema; existing tables are extended in place above (User, Tenant,
// Loan, Session, Client, Lead, LoanApplication, NotificationTemplate→
// MessageTemplate).
//
// Raw-SQL companions to this section (added in the generated migration):
//   1. CREATE UNIQUE INDEX contact_consent_current_unique
//      ON "ContactConsent" ("contactId","channel","purpose")
//      WHERE "effectiveTo" IS NULL;   — partial unique not expressible in Prisma DSL
//   2. CREATE INDEX conversations_unassigned
//      ON "Conversation" ("tenantId","lastInboundAt" ASC)
//      WHERE "assigneeId" IS NULL AND "status" = 'OPEN';
//   3. ALTER TABLE "Message" ADD CONSTRAINT message_recording_requires_disclosure
//      CHECK ("recordingKey" IS NULL OR "disclosureDeliveredAt" IS NOT NULL);

enum Channel {
  EMAIL
  // Canonical spelling — legacy NotificationTemplate.channel rows carrying
  // "WhatsApp" / "whatsapp" / "wa" map here in step 1b.
  WHATSAPP
  VOICE
  SMS
  CHATBOT
  // Notes / activities entered by staff. Never used as a Message channel
  // value — only as a Contact.firstSeenChannel for backfilled rows.
  MANUAL
  // Sentinel for channel-agnostic ContactConsent rows (MARKETING_GLOBAL_
  // OBJECTION, CREDIT_BUREAU_ENQUIRY, AFFORDABILITY_CHECK, DATA_SHARING_
  // THIRD_PARTY, AUTOMATED_DECISIONING). Never used as a Message channel
  // value — enforced via a CHECK constraint added in S2 alongside the
  // outbound cutover.
  ALL_CHANNELS
}

enum ContactStatus {
  UNKNOWN // never matched; no Lead / Client
  LEAD // has leadId
  CLIENT // has clientId
  STAFF // CC'd staff member; do not treat as customer
  BLOCKED // suppression list (do-not-contact, deceased, fraud)
  SPAM // operator-classified spam; archive on receipt, never inbox
  DORMANT // 14-day Unmatched window elapsed without a match
  MERGED // archived after ContactMerge; reads forward via mergedIntoId
}

enum IdentitySource {
  INBOUND // discovered when a message arrived
  MANUAL // operator linked
  IMPORT // CSV / migration backfill
  OAUTH // verified via portal login
  APPLICATION_FORM // captured at loan application
}

enum ConsentPurpose {
  SERVICE_COMMS // statements, reminders, S129 — channel opt-out only
  CROSS_SELL_CREDIT // soft-opt-in lane for T1 clients
  CROSS_SELL_INSURANCE // soft-opt-in lane, gated by tenant IO-opinion flag
  MARKETING_GENERAL // explicit opt-in only
  MARKETING_GLOBAL_OBJECTION // POPIA s.69(3)(c)(ii) master "stop all" toggle
  DATA_SHARING_THIRD_PARTY // POPIA s.11 — share PI with named third parties
  AUTOMATED_DECISIONING // POPIA s.71 — automated decisioning
  CREDIT_BUREAU_ENQUIRY // POPIA s.11 + NCA s.81 (gate)
  AFFORDABILITY_CHECK // NCA s.81 affordability data processing
  CHATBOT_TRANSCRIPT_RETAIN // chatbot session transcript retention
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum ConsentSource {
  APPLICATION_FORM
  PORTAL_TOGGLE
  WA_REPLY_KEYWORD // "Y" / "YES" replies
  CHATBOT_OPT_IN
  CALL_RECORDED_VERBAL // verbal consent on call (cross-sell only — NOT recording itself)
  IMPORT
  MANUAL
  EMAIL_LIST_UNSUBSCRIBE // RFC 8058 one-click unsub from email
}

// LawfulBasis lives on the Message, not on a virtual ContactConsent row.
// Mixing "explicit opt-in" with "s.69(3)(a) soft opt-in" inside ConsentStatus
// mislabels a lawful-basis exemption as recorded consent — auditor red flag.
enum LawfulBasis {
  EXPLICIT_OPT_IN // a GRANTED ContactConsent row authorises this send
  S69_SOFT_OPT_IN // POPIA s.69(3)(a) — active credit relationship; no consent row
  SERVICE_COMMS_NCA // operational comms on existing agreement
  TRANSACTIONAL_OPERATIONAL // password resets, OTPs — bypass marketing-consent rules
  STATUTORY_OVERRIDE // NCA s.129 / court process — overrides channel opt-out
}

enum ConvStatus {
  OPEN
  PENDING_CUSTOMER
  PENDING_INTERNAL
  CLOSED
}

enum ConvPriority {
  NORMAL
  HIGH
  URGENT
}

enum Direction {
  INBOUND
  OUTBOUND
  INTERNAL_NOTE
}

enum Provider {
  RESEND
  SMTP
  MSGRAPH
  WA_UNOFFICIAL
  WA_CLOUD
  WA_BSP_360DIALOG
  TWILIO_VOICE
  TWILIO_SMS
  BULKSMS
  CHATBOT
  MANUAL
}

enum MsgStatus {
  QUEUED
  SENT
  // Provider dispatch was intentionally skipped by an environment dry-run.
  // This is terminal but is never delivery evidence.
  SIMULATED
  DELIVERED
  READ
  FAILED
  // ── Retry cron ────────────────────────────────────────────────────────────
  // Dispatch raised a transient error; the cron sweep will re-attempt
  // according to backoff(retryCount). Terminal once retryCount hits 5 or
  // an EXPIRED / SUPPRESSED_BY_CONSENT transition takes over.
  RETRYING
  // Re-check of canSendTx inside the retry sweep returned ok:false. Most
  // common case: a STOP keyword arrived between the initial send and the
  // retry. Terminal — never retried again.
  SUPPRESSED_BY_CONSENT
  // 5 attempts exhausted OR a permanent 4xx classification (invalid
  // recipient, template rejected, quota exceeded). Terminal.
  FAILED_PERMANENT
  // Message createdAt is older than 24h. Terminal — too stale to keep
  // retrying; ops can manually re-fire from the inbox.
  EXPIRED
  // Provider signalled a hard bounce (deliverability fail). Terminal.
  // Used by the bounce-webhook path (lands later) — declaring it here so
  // future migrations are one-line additions rather than enum extensions.
  BOUNCED
}

// Durable state for the single provider attempt currently controlling an
// outbound Message. The attempt token + lease are the compare-and-set boundary
// shared by the sender and operator reconciliation: neither side may overwrite
// a transition made by the other.
enum MessageDispatchState {
  DISPATCHING
  ACCEPTED
  SIMULATED
  DEFINITELY_REJECTED
  AMBIGUOUS
  RECONCILED_SENT
  RECONCILED_SIMULATED
  RECONCILED_NOT_SENT
}

enum TemplateCategory {
  SERVICE // statements, reminders — operational; channel opt-out respected
  TRANSACTIONAL // password resets, OTPs — bypass marketing-consent rules
  MARKETING // requires consent or s.69(3)(a) soft opt-in
}

enum TemplateProduct {
  GENERAL // service comms not tied to a regulated product
  CREDIT_GENERAL // general credit-product comms (not advice)
  CREDIT_ADVISORY // advice on a credit agreement — FAIS-regulated
  INSURANCE // any insurance product — FAIS-regulated
}

model Contact {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  firstName    String?
  lastName     String?
  primaryEmail String?
  primaryPhone String? // E.164, normalised on write
  primaryWaJid String? // WA JID e.g. 27821234567@s.whatsapp.net

  status   ContactStatus @default(UNKNOWN)
  clientId String?       @unique
  client   Client?       @relation("ClientToContact", fields: [clientId], references: [id], onDelete: Restrict)
  leadId   String?       @unique
  lead     Lead?         @relation("LeadToContact", fields: [leadId], references: [id], onDelete: Restrict)

  // Ambiguous-match staging — null when match was unambiguous.
  // Shape: { "clients": ClientId[], "leads": LeadId[] }
  ambiguousMatchCandidates Json?

  // Per-channel last-inbound timestamp; denormalised from latest INBOUND
  // Message so canSend() can enforce the 24h WA session window without an
  // extra query. Inbound matcher takes SELECT…FOR UPDATE on this row before
  // updating to avoid per-channel timestamp race-loss on a busy Contact.
  // Shape: { "WHATSAPP": ISODate, "EMAIL": ISODate, ... }
  lastInboundAtByChannel Json?

  firstSeenAt      DateTime @default(now())
  firstSeenChannel Channel
  firstSeenContext String?

  blockedAt     DateTime?
  blockedReason String?
  spamScore     Int?

  // Merge bookkeeping (forensic retention — POPIA s.16 + 7y audit window).
  mergedIntoId String?
  mergedInto   Contact?  @relation("ContactMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Contact[] @relation("ContactMerge")

  // Materialised "current consent" pointer set per (channel, purpose).
  // Resolved at write time inside sendMessage(); read-side optimisation.
  // Shape: { "EMAIL:MARKETING_GENERAL": "ckxxx", ... }
  currentConsentIds Json?

  notes String?

  identities    ContactIdentity[]
  conversations Conversation[]
  consents      ContactConsent[]
  mergesFrom    ContactMerge[]    @relation("ContactMergeFrom")
  mergesInto    ContactMerge[]    @relation("ContactMergeInto")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, primaryEmail])
  @@index([tenantId, primaryPhone])
}

model ContactIdentity {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  contactId String
  // Restrict — Contacts are never deleted (MERGED-status preserved per POPIA
  // s.16 audit recall). Cascade here would silently wipe identity history if
  // a future cleanup script ever did delete a Contact.
  contact   Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  channel   Channel
  value     String // normalised: lowercase email, E.164 phone, WA JID
  verified  Boolean        @default(false)
  source    IdentitySource
  createdAt DateTime       @default(now())

  // Tenant-scoped — two tenants may legitimately share a number (shared
  // household phone across tenants in different branches).
  @@unique([tenantId, channel, value])
  @@index([contactId])
  @@index([tenantId, channel, value])
}

model ContactConsent {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  contactId String
  // Restrict — ContactConsent is an append-only POPIA audit log. Cascading
  // deletes from Contact would destroy the "what consent authorised this
  // send" chain on which Message.consentId depends. Combined with the
  // Restrict on Message.consent, Contacts are effectively undeletable —
  // intended invariant.
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  channel     Channel
  purpose     ConsentPurpose
  // GRANTED or REVOKED — NOT_CAPTURED is modelled as the absence of any row.
  status      ConsentStatus
  source      ConsentSource
  // Storage key / signed-PDF page:line / message id / portal URL.
  evidenceRef String?

  // Event-log windows. Append-only — a new row stamps the previous row's
  // effectiveTo inside the same tx. Partial unique index on (contactId,
  // channel, purpose) WHERE effectiveTo IS NULL enforces "one current row"
  // at the DB level — added via raw SQL in the migration (Prisma DSL can't
  // express partial uniques).
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  revokedReason    String?
  // staff user if MANUAL. Restrict — POPIA s.17 operator identity must
  // survive User hard-delete; we deactivate via active=false in normal ops.
  capturedByUserId String?
  capturedByUser   User?   @relation("ContactConsentsCapturedBy", fields: [capturedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  messages Message[]

  @@index([tenantId, contactId, channel, purpose, effectiveFrom])
  @@index([tenantId, channel, purpose, status])
}

model ContactMerge {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  // Both source + target Contacts are Restrict — POPIA s.16 forensic recall
  // depends on the merge audit row pointing at real Contact ids, and Contacts
  // are explicitly undeletable in this schema (see ContactConsent rationale).
  fromContactId   String
  fromContact     Contact  @relation("ContactMergeFrom", fields: [fromContactId], references: [id], onDelete: Restrict)
  intoContactId   String
  intoContact     Contact  @relation("ContactMergeInto", fields: [intoContactId], references: [id], onDelete: Restrict)
  // staff user. Restrict — see ContactConsent.capturedByUser rationale.
  performedById   String
  performedBy     User     @relation("ContactMergesPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  performedAt     DateTime @default(now())
  reason          String // operator-supplied free text
  identitiesMoved Int // count, for rollback-investigation sanity check
  messagesMoved   Int

  @@index([tenantId, performedAt])
  @@index([fromContactId])
  @@index([intoContactId])
}

model Conversation {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  channel            Channel // first channel of the thread; per-Message channel may differ
  websiteChatHandoff WebsiteChatHandoff?
  subject            String?

  status     ConvStatus   @default(OPEN)
  priority   ConvPriority @default(NORMAL)
  assigneeId String?
  assignee   User?        @relation(fields: [assigneeId], references: [id])

  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  // GREATEST(lastInboundAt, lastOutboundAt) materialised as a column, because
  // the inbox queue must rank a thread by ANY traffic on it. Ordering by
  // lastInboundAt alone buried every outbound-only conversation below the
  // first page. A SQL GREATEST() in
  // ORDER BY cannot use a B-tree index and Prisma cannot express it, so the
  // value is maintained by every writer that touches the two fields above.
  lastActivityAt DateTime?
  closedAt       DateTime?

  // SetNull — deleting a Loan or Application (extraordinary) must not
  // cascade-delete conversation history.
  loanId        String?
  loan          Loan?            @relation(fields: [loanId], references: [id], onDelete: SetNull)
  applicationId String?
  application   LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // Set true when a non-rep operator initiates / accepts a voice call about
  // an insurance product, OR when an insurance/credit-advisory template is
  // selected server-side. Triggers FAIS escalation + 5y record-of-advice
  // retention regardless of TemplateCategory.
  faisAdviceCall Boolean @default(false)

  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Inbox triage indexes. The naive composite with assigneeId in the middle
  // does not serve "Unassigned, oldest-first" well — NULL-leading B-tree
  // scans are slow at 10k+ open conversations. The migration adds a partial
  // index (conversations_unassigned) via raw SQL for that view.
  //
  // A partial UNIQUE index — one open thread per contact — is added by raw SQL
  // in the baseline migration (Conversation_one_open_per_contact):
  //   UNIQUE ("tenantId","contactId") WHERE "closedAt" IS NULL
  // Prisma cannot express partial uniques, so it is invisible here. Any new
  // Conversation write must go through lib/inbox/resolve-thread.ts or it will
  // hit P2002.
  @@index([tenantId, assigneeId, status, lastInboundAt(sort: Desc)])
  @@index([tenantId, channel, status, lastInboundAt(sort: Desc)])
  // Queue ordering is by lastActivityAt; these mirror the lastInboundAt
  // shapes above so listConversations keeps an index-ordered scan.
  @@index([tenantId, assigneeId, status, lastActivityAt(sort: Desc)])
  @@index([tenantId, channel, status, lastActivityAt(sort: Desc)])
  @@index([tenantId, contactId])
}

model Message {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  channel           Channel
  direction         Direction
  provider          Provider
  // Provider-scoped uniqueness. Provider message-ids are not coordinated
  // across providers (Twilio + WA BSPs may reuse the same opaque string),
  // so the unique is composite on (provider, providerMessageId). NULL is
  // allowed (composite unique permits NULLs as distinct per PG semantics)
  // for inbound webhooks that haven't yet returned a provider id.
  providerMessageId String?

  fromValue String? // normalised channel value
  toValue   String?

  subject  String?
  bodyText String?
  bodyHtml String?

  // Inbound attachments are NOT raw blobs — customer-supplied documents
  // (ID copies, payslips, bank statements) are persisted as ClientDocument
  // rows and referenced by id. Opening one goes through assertDocument
  // Access() which writes a DocumentAccessLog row (POPIA + lib/document-
  // auth.ts).
  documentRefs    Json? // string[] — ClientDocument.id list
  attachmentsMeta Json? // [{ documentId, name, mimeType, size }]

  // Voice-specific
  callDurationSec Int?
  recordingKey    String? // VPS disk / S3 key
  transcript      String?

  // Call-recording disclosure (s.18 notification, NOT consent).
  // Outbound: operator marks delivered before recording starts. Inbound: set
  // when the TwiML <Play> playback-complete callback fires. Recording does
  // not start (outbound) / is muted (inbound) until this is set. Enforced by
  // a CHECK constraint added in raw SQL.
  disclosureDeliveredAt   DateTime?
  // staff user (outbound) or null (auto-played inbound). Restrict — CPA s.11
  // / s.18 operator-identity preservation.
  disclosureDeliveredById String?
  disclosureDeliveredBy   User?            @relation("MessagesDisclosureDeliveredBy", fields: [disclosureDeliveredById], references: [id], onDelete: Restrict)
  // Versioned MessageTemplate (category SERVICE). Restrict — parallel to
  // `templateId` below: a referenced disclosure template cannot be hard-
  // deleted while messages still cite it as the played-clip-of-record.
  disclosureTemplateId    String?
  disclosureTemplate      MessageTemplate? @relation("MessagesDisclosureTemplate", fields: [disclosureTemplateId], references: [id], onDelete: Restrict)

  // Template provenance — Restrict so a referenced template cannot be hard-
  // deleted while messages still reference it (use active=false / enabled=false).
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // Lawful basis is the authoritative "why was this send permitted?" answer.
  // Stored on the Message itself so the audit trail is immutable.
  lawfulBasis   LawfulBasis?
  basisEvidence String? // human-readable evidence string from canSend()
  // Set ONLY when lawfulBasis = EXPLICIT_OPT_IN; references the immutable
  // ContactConsent row that authorised this send.
  consentId     String?
  consent       ContactConsent? @relation(fields: [consentId], references: [id], onDelete: Restrict)

  // Fresh-2FA assertion that authorised this send — used by the voice-token
  // mint flow + sensitive outbound (manual disbursement comms etc.).
  totpAssertionId String?

  // Per-message classifier output. Independent of Contact.status = SPAM
  // (operator's deliberate "this person is spam" decision). Quarantined
  // messages land in the Quarantine inbox view for operator triage.
  quarantined Boolean @default(false)

  status       MsgStatus @default(QUEUED)
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  repliedAt    DateTime?

  // ── Retry bookkeeping ──────────────────────────────────────────────────
  // Number of dispatch attempts so far (0 = never tried, 1 = one failure
  // already retried, ..., 5 = exhausted → status transitions to
  // FAILED_PERMANENT).
  retryCount  Int       @default(0)
  // When the cron sweep is next eligible to pick this row up. NULL for any
  // non-RETRYING row.
  nextRetryAt DateTime?
  // Wall-clock of the most recent classified failure. Distinct from
  // sentAt — that lives on the success path. Used by ops to see "is this
  // row actually being retried, or stuck?".
  lastErrorAt DateTime?
  // Classification result from lib/messaging/retry.ts:classifyError, or the
  // durable no-replay/manual-reconciliation claim written before a retry
  // crosses the provider boundary. Free-form so operational recovery markers
  // do not require enum migrations.
  errorClass  String?

  // Optional workflow-level reservation. Automated callers use a deterministic
  // key (subject + event + channel + occurrence) so a process restart cannot
  // create a fresh Message for the same business event. NULL keeps intentional
  // free-form staff messages repeatable.
  idempotencyKey String? @db.VarChar(256)

  // SHA-256 of the complete immutable outbound request (rendered bodies,
  // recipient, business linkages, email headers and attachment byte hashes).
  // Reusing a business idempotency key is allowed only for this exact digest.
  payloadFingerprint String? @db.Char(64)

  // Durable provider-boundary control. A fresh token is committed before every
  // initial/retry provider call. Provider completion and operator reconciliation
  // both CAS on this token/state. The provider's real id is kept separately from
  // the human evidence/case reference used during reconciliation.
  dispatchToken                   String?               @unique @db.VarChar(64)
  dispatchState                   MessageDispatchState?
  dispatchAttempt                 Int                   @default(0)
  dispatchStartedAt               DateTime?
  dispatchLeaseExpiresAt          DateTime?
  dispatchCompletedAt             DateTime?
  dispatchProviderMessageId       String?
  dispatchProviderAcceptedAt      DateTime?
  dispatchEvidenceReference       String?               @db.VarChar(512)
  reconciliationEvidenceReference String?               @db.VarChar(512)
  // A local dry-run receipt is not a provider message id. Keeping it separate
  // prevents simulated rows from masquerading as externally accepted sends.
  simulationReceiptId             String?               @db.VarChar(512)

  notificationLogs NotificationLog[]

  isInternal  Boolean @default(false) // operator note; never sent outbound
  // outbound + internal-note author. Restrict — POPIA s.17 + FAIS GCC s.3(2)
  // operator identity must persist past User deactivation.
  createdById String?
  createdBy   User?   @relation("MessagesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Note mutability. Only INTERNAL_NOTE rows may carry these — enforced by
  // Message_internal_note_mutability_guard, which also makes every non-note
  // bodyText unrewritable at the database.
  editedAt    DateTime?
  editedById  String?
  editedBy    User?     @relation("MessagesEditedBy", fields: [editedById], references: [id], onDelete: Restrict)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("MessagesDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  mentions MessageMention[]

  @@unique([provider, providerMessageId])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, dispatchState, dispatchLeaseExpiresAt], map: "Message_dispatch_reconciliation_idx")
  @@index([nextRetryAt], map: "Message_retry_idx")
}

/// Who was tagged in an internal note. Resolved at write time from the
/// composer's picker, never re-parsed from the body: a staff rename would
/// otherwise silently repoint or break an old mention.
model MessageMention {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [tenantId, messageId], references: [tenantId, id], onDelete: Cascade)
  /// Restrict, matching Message.createdById — who was tagged is operator
  /// identity and must persist past deactivation.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([tenantId, userId, createdAt])
}

// Referral agents.
model ReferralAgent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  displayName   String
  legalName     String?
  phone         String?
  email         String?
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED | CLOSED
  channel       String   @default("FIELD") // FIELD | SOCIAL | STAFF | PARTNER
  notes         String?
  commissionBps Int? // per-agent override of TenantConfig.referralCommissionBps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  referralCodes  ReferralCode[]
  referralEvents ReferralEvent[]

  @@index([tenantId, status])
}

model ReferralCode {
  id       String        @id @default(cuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  agentId  String
  agent    ReferralAgent @relation(fields: [agentId], references: [id], onDelete: Restrict)

  code      String
  label     String?
  status    String   @default("ACTIVE") // ACTIVE | PAUSED | RETIRED
  campaign  String?
  qrPath    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  leads             Lead[]
  referralEvents    ReferralEvent[]
  attributedClients Client[]        @relation("ClientReferralCode")

  @@unique([tenantId, code])
  @@index([tenantId, agentId])
  @@index([tenantId, status])
}

model ReferralEvent {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  agentId  String?
  agent    ReferralAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  codeId   String?
  code     ReferralCode?  @relation(fields: [codeId], references: [id], onDelete: SetNull)
  leadId   String?
  lead     Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  eventType        String // CLICK | WEBSITE_APPLICATION | HANDOFF | CONVERTED | PAYOUT_ELIGIBLE | BLOCKED
  source           String? // WEBSITE | WHATSAPP | SOCIAL | FIELD
  attributionRaw   String?
  amountCents      Int?
  commissionCents  Int? // computed payable figure; distinct from amountCents (loan-principal context)
  commissionStatus String   @default("NOT_ELIGIBLE") // NOT_ELIGIBLE | PENDING | PAYABLE | BLOCKED | REVERSED
  qualityFlag      String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, agentId, createdAt])
  @@index([tenantId, codeId, createdAt])
  @@index([tenantId, leadId])
}

model WebhookSignatureFailure {
  id            String   @id @default(cuid())
  // Nullable: signature failures may predate tenant resolution (the request
  // hadn't been authenticated yet). SetNull on Tenant delete keeps the
  // forensic record for breach-audit purposes.
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // "TWILIO" | "BULKSMS" | "META_WA" | "WA_UNOFFICIAL"
  provider      String
  sourceIp      String?
  pathname      String
  // "MISSING_HEADER" | "BAD_HMAC" | "STALE_TIMESTAMP" | "REPLAY"
  reason        String
  rawHeaders    Json
  // sha256 of the raw body — never the body itself; we don't persist
  // unverified payloads.
  rawBodySha256 String
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
}

model CommsSettings {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  whatsappEnabled   Boolean  @default(false)
  botsEnabled       Boolean  @default(true)
  chatAlertEmail    String?
  waProvider        String   @default("WA_UNOFFICIAL") // WA_UNOFFICIAL | WA_CLOUD | WA_BSP_360DIALOG
  // WhatsApp Cloud API (official) per-tenant credentials.
  // NOTE: stored plaintext following the existing TenantConfig.*Key precedent.
  // Access ONLY via lib/whatsapp-cloud-config.getWabaCreds so encryption can
  // be added in one place later. Tracked as an open question in the PRD.
  // wabaPhoneNumberId + wabaAccessToken (send creds) are read by getWabaCreds.
  // INBOUND webhook verification is NOT sourced from these columns: the
  // /api/webhooks/whatsapp-cloud handler verifies the x-hub-signature-256 HMAC
  // against env WHATSAPP_CLOUD_APP_SECRET and the GET handshake against env
  // WHATSAPP_CLOUD_VERIFY_TOKEN. That is deliberate — under Meta Embedded Signup
  // every tenant WABA subscribes to our single Tech-Provider app, so there is
  // one app secret / verify token (env), not one per tenant. The wabaAppSecret /
  // wabaVerifyToken columns are RESERVED for a future per-tenant-own-app model
  // and are not consulted for verification today; do not treat them as live
  // inbound config.
  wabaId            String?
  wabaPhoneNumberId String?  @unique
  wabaAccessToken   String?
  wabaAppSecret     String?
  wabaBusinessId    String?
  wabaVerifyToken   String?
  businessHours     Json? // { tz: string, days: { mon: { open: "08:00", close: "17:00" } | null, ... } }
  autoReplyEnabled  Boolean  @default(false)
  autoReplyText     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WaBridgeNumber {
  id                   String    @id @default(cuid())
  slotId               String    @unique
  number               String?
  status               String // CONNECTING | CONNECTED | DISCONNECTED | LOGGED_OUT | RETIRED
  priority             Int
  connectedAt          DateTime?
  disconnectedAt       DateTime?
  lastDisconnectReason String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Singleton (id is always "singleton") tracking whether the check-wa-bridge-status
// cron has an unresolved full-pool-down alarm on record. Independent of
// WaBridgeNumber's per-slot status: decideWaBridgeAlert only sees CONNECTED->bad
// transitions between polls, so it can't detect a bridge that was ALREADY down
// when the cron started (cold start) or stuck down across every poll. This flag
// closes that hole -- see app/api/cron/check-wa-bridge-status/route.ts.
model WaBridgeAlarm {
  id            String    @id @default("singleton")
  active        Boolean   @default(false)
  lastAlertedAt DateTime?
  updatedAt     DateTime  @updatedAt
}

model CannedReply {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String
  body        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model ManualProgress {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  lessonSlug  String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
  @@index([tenantId, userId])
}

// Atomic per-recipient throttle for outbound notifications that must be rate
// bounded across concurrent requests (e.g. the identity-conflict portal notice
// in app/api/website/apply). A row claims one send for `channelKey` within a
// fixed time bucket (`windowStart`); the unique constraint makes the claim
// atomic, so concurrent requests can't both pass a check-then-act race and
// double-send. Rows are disposable — safe to prune by `createdAt`.
model NotificationThrottle {
  id          String   @id @default(cuid())
  tenantId    String
  channelKey  String // e.g. "portal-identity-notice:<recipient-email>"
  windowStart DateTime // start of the fixed rate-limit bucket
  createdAt   DateTime @default(now())

  @@unique([tenantId, channelKey, windowStart])
  @@index([createdAt])
}

// ─── Decline categories ────────────────────────────────────────────────────

enum DeclineCategory {
  AFFORDABILITY
  BUREAU_SCORE
  ADVERSE_LISTING
  DEBT_REVIEW
  DOCUMENTS_INCOMPLETE
  IDENTITY
  WITHDRAWN
}

model WebsiteChatHandoff {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  conversationId   String       @unique
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  handedOffAt      DateTime
  /// Set when nobody joined within the wait, or at hand-off when after hours.
  timedOutAt       DateTime?
  alertEmailSentAt DateTime?
  alertAttempts    Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([tenantId, timedOutAt, handedOffAt])
}

// ── Bureau data submission (SACRRA Layout 700v2 → Experian) ────────────────
// lib/bureau-submission. The ledger is the record of what the bureau was
// told: files are never written to disk, they are re-rendered from `fields`.

enum BureauSubmissionKind {
  DAILY
  MONTHLY
}

enum BureauSubmissionMode {
  TEST
  LIVE
}

enum BureauSubmissionStatus {
  GENERATED
  PUSHED
  FAILED
  REJECTED
}

model BureauSubmission {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  kind        BureauSubmissionKind
  /// Month-end date (MONTHLY) or transaction date (DAILY), a SAST calendar day.
  periodDate  DateTime                 @db.Date
  mode        BureauSubmissionMode
  sequence    Int
  fileName    String
  sha256      String
  /// Lines sent, header and trailer excluded.
  recordCount Int
  heldCount   Int
  /// Header field values as rendered (MONTHLY only), so a re-render does not
  /// depend on TenantConfig as it is today.
  header      Json?
  status      BureauSubmissionStatus   @default(GENERATED)
  pushedAt    DateTime?
  createdAt   DateTime                 @default(now())
  records     BureauSubmissionRecord[]

  @@unique([tenantId, kind, periodDate, mode, sequence])
  @@index([tenantId, createdAt])
}

model BureauSubmissionRecord {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  submissionId String
  submission   BureauSubmission     @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  /// Copied from the submission: a partial unique index cannot see another
  /// table, and the once-only guard is keyed on both.
  kind         BureauSubmissionKind
  mode         BureauSubmissionMode
  loanId       String
  loan         Loan                 @relation(fields: [loanId], references: [id], onDelete: Restrict)
  /// Position among the sent lines; null for a held record.
  lineNo       Int?
  dataFlag     String
  statusCode   String?
  statusDate   DateTime?            @db.Date
  /// Every field value of the line, as rendered.
  fields       Json
  /// Comma-separated hold reasons; null means the line was sent.
  heldReason   String?
  createdAt    DateTime             @default(now())

  // A raw-SQL partial unique index in the migration (not expressible here)
  // lets a once-only status (C, T, W, L, Z) be sent once per loan per kind
  // in LIVE mode: "BureauSubmissionRecord_live_once_only_status_key".
  @@index([submissionId])
  @@index([tenantId, loanId])
}

/// A staff member's confirmation that the consumer was given notice before an
/// adverse status (W written off, L handed over) is listed. Without one the
/// loan keeps reporting its arrears with no status code.
model BureauAdverseConfirmation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Restrict)
  statusCode    String
  /// The date notice was given to the consumer.
  noticeDate    DateTime @db.Date
  confirmedById String
  confirmedAt   DateTime @default(now())

  @@unique([loanId, statusCode])
  @@index([tenantId])
}

enum ReferenceRateBasis {
  FIXED
  PRIME
  REPO
  JIBAR
  ZARONIA
  LENDER_BASE
}

enum ReferenceRateStatus {
  PENDING
  APPROVED
  REJECTED
}

// A dated reference rate per tenant (DESIGN D4). A value applies from its
// effectiveDate until the next APPROVED one for the same basis. Four-eyes:
// recorded PENDING by one user, APPROVED or REJECTED by another; only APPROVED
// values reprice loans. Requester and decider are users of the row's own
// tenant (composite FKs). One live (non-REJECTED) value per (tenant, basis,
// date) is the hand-written partial unique index ReferenceRate_live_key;
// the rate band, born-PENDING, decision completeness, four-eyes and
// immutability rules are hand-written too (migration
// 20261013100000_asset_finance_rates_vat).
model ReferenceRate {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  basis         ReferenceRateBasis
  effectiveDate DateTime            @db.Date
  // Annual nominal rate as a decimal: 0.1175 = 11.75%.
  rate          Decimal             @db.Decimal(9, 6)
  status        ReferenceRateStatus @default(PENDING)
  requestedById String
  requestedBy   User                @relation("ReferenceRatesRequested", fields: [tenantId, requestedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedById   String?
  decidedBy     User?               @relation("ReferenceRatesDecided", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedAt     DateTime?
  createdAt     DateTime            @default(now())

  @@index([tenantId, basis, effectiveDate])
}

// A loan's rate history: the contract rate from each effectiveDate, as
// reference + margin or fixed. Unique per (loan, effectiveDate), so a repricing
// run for the same reference change is idempotent.
model ContractRate {
  id                 String             @id @default(cuid())
  tenantId           String
  loanId             String
  loan               Loan               @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  effectiveDate      DateTime           @db.Date
  basis              ReferenceRateBasis
  margin             Decimal?           @db.Decimal(9, 6)
  fixedRate          Decimal?           @db.Decimal(9, 6)
  resultingRate      Decimal            @db.Decimal(9, 6)
  // The base instalment B the schedule was solved with from this date (cents):
  // booking records the solver's B, each repricing its new B. Repricing reads
  // the latest one back to derive the period weights exactly
  // (lib/asset-finance/schedule-records.ts deriveWeights); null only on rows
  // written before that convention, which fall back to an estimate.
  newInstalmentCents Int?
  createdById        String?
  createdAt          DateTime           @default(now())

  @@unique([loanId, effectiveDate])
  @@index([tenantId])
}

// Per-tenant VAT vendor identity for tax invoices (lib/vat/).
model VatConfig {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  vatNumber      String
  registeredName String
  address        String
  updatedAt      DateTime @updatedAt
}

// The VAT rate in force from effectiveDate (national, not per tenant). History:
// never updated or deleted; a new row must take effect after today, and a tax
// invoice's vatRate must be the rate in force on its supplyDate (hand-written
// triggers, migration 20261013100000).
model VatRate {
  id            String   @id @default(cuid())
  effectiveDate DateTime @unique @db.Date
  rate          Decimal  @db.Decimal(6, 4)
}

// An issued tax invoice. Every amount and party detail is copied in at issue;
// a DB trigger blocks UPDATE and DELETE. Corrections are CreditNotes. The
// insert trigger assigns the gap-free per-tenant number (max + 1 under an
// advisory lock; CreditNote likewise).
model TaxInvoice {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  number             Int
  // Display number, e.g. "INV-000123".
  invoiceNumber      String
  issueDate          DateTime         @db.Date
  supplyDate         DateTime         @db.Date
  loanId             String?
  loan               Loan?            @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  supplierName       String
  supplierAddress    String
  supplierVatNumber  String
  recipientName      String
  recipientAddress   String
  recipientVatNumber String?
  vatRate            Decimal          @db.Decimal(6, 4)
  totalExclVatCents  Int
  vatCents           Int
  totalInclVatCents  Int
  createdById        String?
  createdAt          DateTime         @default(now())
  lines              TaxInvoiceLine[]
  leaseRental        LeaseRental?
  creditNotes        CreditNote[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([loanId])
}

model TaxInvoiceLine {
  id               String     @id @default(cuid())
  invoiceId        String
  invoice          TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNo           Int
  description      String
  quantity         Int        @default(1)
  unitExclVatCents Int
  exclVatCents     Int
  vatCents         Int
  inclVatCents     Int

  @@unique([invoiceId, lineNo])
}

model CreditNote {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  number           Int
  creditNoteNumber String
  issueDate        DateTime   @db.Date
  invoiceId        String
  invoice          TaxInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reason           String
  exclVatCents     Int
  vatCents         Int
  inclVatCents     Int
  createdById      String?
  createdAt        DateTime   @default(now())

  @@unique([tenantId, number])
}

enum EntityDocumentType {
  CIPC_REGISTRATION
