// ── Notification / Message Templates ─────────────────────────────────────────
//
// The legacy (tenantId, event, channel) unique is retained alongside the
// canonical (tenantId, key) lookup.

model MessageTemplate {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  // Legacy lookup key — retained until every outbound call site uses `key`
  // (spec §Outbound call-site inventory). 1c drops the legacy unique.
  event    String
  // Step 1b retyped this from String to the Channel enum via the
  // channel_legacy rollback column (kept until 1c drops it).
  channel  Channel
  subject  String?
  body     String
  active   Boolean @default(true)

  // ── Phase 9 additive columns (step 1a) ───────────────────────────────────
  // New stable identifier — nullable in 1a, backfilled in 1b from `event`,
  // NOT-NULL in 1c.
  key                String?
  category           TemplateCategory?
  // Required only for MARKETING category — null for SERVICE / TRANSACTIONAL.
  // Validated at write time in the Settings → Templates editor.
  purposeRequired    ConsentPurpose?
  // FAIS gate. INSURANCE and CREDIT_ADVISORY product templates are disabled
  // in the compose box for operators where User.faisRepresentative = false
  // (spec §FAIS boundary). v2 expands to a per-template sub-category list.
  product            TemplateProduct   @default(GENERAL)
  // s.129 / court-process — only `true` bypasses channel-level opt-out.
  // Reviewed by compliance officer on creation; routine SERVICE templates
  // never set this true.
  statutoryOverride  Boolean           @default(false)
  // Body-secrecy flag. `true` means the rendered body carries a live secret —
  // a one-time code or a tokenised signing link — so sendMessage() persists a
  // placeholder in Message.bodyText/bodyHtml instead of the real body. The
  // provider still receives the TRUE body and the payloadFingerprint is still
  // computed over the TRUE payload, so proof-of-sending and evidence
  // integrity survive without putting the secret on the staff-visible comms
  // timeline (an account-takeover / signature-forgery path).
  //
  // Deliberately a TEMPLATE-level flag rather than a per-send option: a new
  // callsite cannot forget to set it.
  redactStoredBody   Boolean           @default(false)
  // WABA-shaped fields. Approved-name is set once Meta approves the template
  // submission (spec §WABA template submission — owned, scheduled).
  wabaTemplateName   String?
  language           String            @default("en")
  headerType         String?
  headerContent      String?
  bodyTemplate       String?
  footer             String?
  buttons            Json?
  providerStatus     String?
  providerTemplateId String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  messages           Message[]
  // Back-reference for the named "MessagesDisclosureTemplate" relation:
  // Messages that cited this template as their s.18 call-recording
  // disclosure clip (TwiML <Play>). Restrict semantics live on the child.
  disclosureMessages Message[] @relation("MessagesDisclosureTemplate")

  @@unique([tenantId, event, channel])
  @@unique([tenantId, key])
}

