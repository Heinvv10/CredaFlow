  referenceId               String? // loan id, policy id, etc.
  status                    EmailLogStatus @default(QUEUED)
  provider                  Provider?
  messageId                 String? // provider message ID for tracking
  // Request-scoped provider evidence when no message id exists (for example
  // Graph request-id/client-request-id correlation for a sendMail HTTP 202).
  providerEvidenceReference String?        @db.VarChar(512)
  sentAt                    DateTime?
  openedAt                  DateTime?
  repliedAt                 DateTime?
  errorMessage              String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

