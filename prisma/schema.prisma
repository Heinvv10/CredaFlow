  client                                  Client?                    @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  entity                                  BusinessEntity?            @relation(fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  ncaRepresentative                       Client?                    @relation("NcaRepresentative", fields: [tenantId, ncaRepresentativeClientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "LoanApplication_ncaRepresentativeClientId_fkey")
  ncaRegimeOverrides                      NcaRegimeOverride[]
  assetFinanceDeal                        AssetFinanceDeal?
  product                                 LoanProduct                @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  creditLifeProduct                       InsuranceProduct?          @relation("ApplicationCreditLifeProduct", fields: [tenantId, creditLifeProductId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  creditLifeInsurer                       Insurer?                   @relation("ApplicationCreditLifeInsurer", fields: [tenantId, creditLifeInsurerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  assignedTo                              User?                      @relation("AssignedTo", fields: [assignedToId], references: [id])
  approvedBy                              User?                      @relation("ApprovedBy", fields: [tenantId, approvedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  agreementCountersignedBy                User?                      @relation("AgreementCountersignedBy", fields: [tenantId, agreementCountersignedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  agreementSignedBy                       User?                      @relation("AgreementSignedBy", fields: [tenantId, agreementSignedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  loan                                    Loan?
