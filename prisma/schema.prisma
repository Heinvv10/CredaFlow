  complaints                         Complaint[]
  dsarRequests                       DataSubjectRequest[]
  consent                            ClientConsent?
  bureauChecks                       CreditBureauCheck[]
  contact                            Contact?                 @relation("ClientToContact")
  avsChecks                          AvsCheck[]
  convertedLeads                     Lead[]                   @relation("LeadConvertedClient")
  portalAccountLeads                 Lead[]                   @relation("LeadPortalAccountClient")
  kycOverrideRequests                KycOverrideRequest[]

