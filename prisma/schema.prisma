model ClientDocument {
  id                       String               @id @default(cuid())
  tenantId                 String
  tenant                   Tenant               @relation(fields: [tenantId], references: [id])
  clientId                 String
  docType                  DocType
  fileUrl                  String
  fileName                 String
  verified                 Boolean              @default(false)
  // Who refused this document, if anyone. Set only by a human reviewer through
  // the verify endpoint. The SYSTEM also clears `verified` and writes a
  // verificationNote (a bank-detail change re-flags a statement), so the note
  // alone cannot say who acted — these fields can.
  verificationRejectedAt   DateTime?
  verificationRejectedById String?
  uploadedByType           String               @default("staff")
  uploadedById             String?
  deletedAt                DateTime?
  deletedByType            String?
  deletedById              String?
  fileSize                 Int?
  mimeType                 String?
  storagePath              String?
  contentSha256            String?
  extractionStatus         String               @default("pending")
  extractionGeneration     String?
  extractionStartedAt      DateTime?
  extractionResult         Json?
  extractionError          String?
  validationResult         Json?
  validationMismatch       Boolean              @default(false)
  validationScore          Int?
  biometricMatchScore      Int?
  biometricLiveness        Int?
  biometricVerifiedAt      DateTime?
  biometricResult          Json?
  biometricAttemptSequence Int?
  verifiedAt               DateTime?
  verifiedById             String?
  verificationNote         String?
  // Provenance for docs generated via the Document Template System — nullable,
  // NULL for staff-uploaded / OCR-captured documents.
  templateId               String?
  generatedFromVersionId   String?
  // Native (in-app) e-signature state — see lib/documents/signing/native.ts +
  // app/api/documents/[id]/sign/route.ts. NULL for documents never sent for
  // signature (mirrors SignatureState "none" in lib/documents/signing/index.ts).
  signatureState           String?
  signatureRequestedAt     DateTime?
  signedAt                 DateTime?
  signedByIp               String?
  createdAt                DateTime             @default(now())
  client                   Client               @relation(fields: [clientId], references: [id])
  loanNotes                LoanNote[]
  statementAnalyses        StatementAnalysis[]
  kycOverrideRequests      KycOverrideRequest[]

