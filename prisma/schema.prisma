  signedPacketDocumentId                  String?
  signedPacketDocumentSha256              String?
  debitMandatePreparedAt                  DateTime?
  debitMandateReference                   String?
  debitMandateDraftSha256                 String?
  debitMandateEvidence                    Json?
  debitMandateEvidenceSha256              String?
  debitMandateSignedAt                    DateTime?
  debitMandateSignedMethod                String?
  debitMandateSignedByIp                  String?
  debitMandateSignatureData               String?
  debitMandateSignatureSha256             String?
  debitMandateDocumentId                  String?
  debitMandateDocumentSha256              String?
