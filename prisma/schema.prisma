enum EmailProvider {
  MSGRAPH
  IMAP_SMTP
}

model EmailConfig {
  id               String        @id @default(cuid())
  tenantId         String        @unique
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  provider         EmailProvider @default(IMAP_SMTP)
  fromName         String
  fromAddress      String
  // Default Reply-To for customer-facing mail (e.g. support@). Per-send
  // overrides still win (Section 129/collections force collections@). When
  // null, replies go back to fromAddress.
  replyToAddress   String?
  // MS Graph fields
  tenantAzureId    String?
  clientId         String?
  clientSecret     String? // stored encrypted
  // IMAP/SMTP fields
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String? // stored encrypted
  imapHost         String?
  imapPort         Int?
  imapUser         String?
  imapPass         String? // stored encrypted
  useTls           Boolean       @default(true)
  active           Boolean       @default(true)
  lastTestedAt     DateTime?
  lastTestOk       Boolean?
  // IMAP login check (POST /api/email/test-imap) — distinct from lastTestedAt,
  // which records an outbound SMTP/Graph SEND. An operator debugging dead
  // inbound needs to know the mailbox login works without emitting mail.
  lastImapTestedAt DateTime?
  lastImapTestOk   Boolean?
  // Inbound poll outcome, written by lib/email/inbound-poll.ts on every run
  // (cron and the manual button). Before this, 1,966 consecutive IMAP TLS
  // failures were invisible because nothing durable recorded them.
  lastPollAt       DateTime?
  lastPollOk       Boolean?
  lastPollError    String?       @db.VarChar(512)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum EmailLogStatus {
  QUEUED
  SENT
  AMBIGUOUS
  FAILED
  BOUNCED
  OPENED
  REPLIED
  // Refused by this system before dispatch — the recipient's domain is not
  // reachable from a non-production environment. Deliberately NOT folded into
  // FAILED: "we declined to send" and "the provider rejected it" are different
  // facts, and an auditor asking what a test environment tried to send to a
  // member of the public needs to be able to see the first one.
  BLOCKED
}

model EmailLog {
  id                        String         @id @default(cuid())
