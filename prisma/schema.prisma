generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                                @id @default(cuid())
  email                        String                                @unique
  name                         String?
  password                     String
  role                         UserRole                              @default(CREDIT_OFFICER)
  isCommsAgent                 Boolean                               @default(false)
  active                       Boolean                               @default(true)
  tenantId                     String?
  tenant                       Tenant?                               @relation(fields: [tenantId], references: [id])
  branchId                     String?
  branch                       Branch?                               @relation(fields: [branchId], references: [id])
  totpSecret                   String?
  totpEnabled                  Boolean                               @default(false)
  lastTotpCounter              Int?
  phone                        String?
  lastLoginAt                  DateTime?
  resetToken                   String?                               @unique
  resetTokenExp                DateTime?
  qualificationCategory        String?
  // Bumped whenever an existing session must be invalidated (deactivate,
  // role change, password reset). Compared on every JWT decode — see
  // lib/auth.ts jwt callback.
  tokenVersion                 Int                                   @default(0)
  // FAIS Cat I representative tag (Phase 9). Maintained by compliance via
  // Settings → Users; the FSP keeps the authoritative Rep Register
  // separately. Gates insurance / credit-advisory templates in the compose
  // box (see spec §FAIS boundary).
  faisRepresentative           Boolean                               @default(false)
  faisRepresentativeNumber     String?
  faisRepresentativeFrom       DateTime?
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt
  loginLogs                    LoginLog[]
  sessions                     Session[]
  accounts                     Account[]
  approvedLoans                LoanApplication[]                     @relation("ApprovedBy")
  clearedCheckFlags            ApplicationCheckFlag[]                @relation("CheckFlagClearedBy")
  branchSignedApplications     LoanApplication[]                     @relation("AgreementSignedBy")
  countersignedApplications    LoanApplication[]                     @relation("AgreementCountersignedBy")
  bureauOverriddenApplications LoanApplication[]                     @relation("BureauOverrideBy")
  assignedLoans                LoanApplication[]                     @relation("AssignedTo")
  auditLogs                    AuditLog[]
  fitAndProper                 FitAndProper?
  coiDeclarations              CoiDeclaration[]
  advisorPolicies              InsurancePolicy[]                     @relation("AdvisorPolicies")
  advisorQuotes                InsuranceQuote[]                      @relation("AdvisorQuotes")
  adviceRecordsRecorded        InsuranceAdviceRecord[]               @relation("AdviceRecordedBy")
  advisorCommissions           AdvisorCommission[]
  assessedClaims               InsuranceClaim[]                      @relation("ClaimAssessor")
  agentTasks                   AgentTask[]
  assignedConversations        Conversation[]
  // Phase 9 audit-pointer relations. Restrict on each (declared on the
  // child-side relation) — User hard-delete is already non-normal (we
  // deactivate via active=false); blocking it on outstanding audit
  // references is the auditor-safe default for POPIA s.17 operator-identity
  // records and FAIS GCC s.3(2) record-of-advice retention.
  contactMergesPerformed       ContactMerge[]                        @relation("ContactMergesPerformedBy")
  contactConsentsCaptured      ContactConsent[]                      @relation("ContactConsentsCapturedBy")
  messagesAuthored             Message[]                             @relation("MessagesCreatedBy")
  messagesEdited               Message[]                             @relation("MessagesEditedBy")
  messagesDeleted              Message[]                             @relation("MessagesDeletedBy")
  messagesDisclosureDelivered  Message[]                             @relation("MessagesDisclosureDeliveredBy")
  manualProgress               ManualProgress[]
  notifications                Notification[]
  pasqAckTokensIssued          PasqAcknowledgementToken[]            @relation("PasqAckTokensIssuedBy")
  selfieCaptureTokensIssued    SelfieCaptureToken[]                  @relation("SelfieCaptureTokensIssuedBy")
  mentionedIn                  MessageMention[]
  ncaOverridesRequested        NcaRegimeOverride[]                   @relation("NcaOverridesRequested")
  ncaOverridesDecided          NcaRegimeOverride[]                   @relation("NcaOverridesDecided")
  payoutChecklistConfirmed     PayoutChecklistItem[]                 @relation("PayoutChecklistConfirmedBy")
  payoutsCreated               Payout[]                              @relation("PayoutsCreatedBy")
  payoutsApproved              Payout[]                              @relation("PayoutsApprovedBy")
  payoutsReleased              Payout[]                              @relation("PayoutsReleasedBy")
  payoutsCancelled             Payout[]                              @relation("PayoutsCancelledBy")
  supplierAccountsRequested    SupplierBankAccount[]                 @relation("SupplierAccountRequestedBy")
  supplierAccountsDecided      SupplierBankAccount[]                 @relation("SupplierAccountDecidedBy")
  assetDealsCancelled          AssetFinanceDeal[]                    @relation("AssetDealCancelledBy")
  referenceRatesRequested      ReferenceRate[]                       @relation("ReferenceRatesRequested")
  referenceRatesDecided        ReferenceRate[]                       @relation("ReferenceRatesDecided")
  assetAffordabilityAssessed   AssetFinanceAffordabilityAssessment[]
  kycOverrideRequestsMade      KycOverrideRequest[]                  @relation("KycOverrideRequestedBy")
  kycOverrideRequestsDecided   KycOverrideRequest[]                  @relation("KycOverrideDecidedBy")

  @@unique([tenantId, id])
}

model Tenant {
  id                         String                      @id @default(cuid())
  slug                       String                      @unique
  name                       String
  domain                     String?                     @unique
  status                     TenantStatus                @default(ACTIVE)
  config                     TenantConfig?
  users                      User[]
  attorneyFirms              AttorneyFirm[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  clients                    Client[]
  loans                      Loan[]
  loanApplications           LoanApplication[]
  pasqAcknowledgementTokens  PasqAcknowledgementToken[]
  selfieCaptureTokens        SelfieCaptureToken[]
  payments                   Payment[]
  repaymentSchedules         RepaymentSchedule[]
  loanProducts               LoanProduct[]
  paymentArrangements        PaymentArrangement[]
  clientDocuments            ClientDocument[]
  loanNotes                  LoanNote[]
  tcfOutcomes                TcfOutcome[]
  breachLogs                 BreachLog[]
  coiDeclarations            CoiDeclaration[]
  insurers                   Insurer[]
  loginLogs                  LoginLog[]
  leads                      Lead[]
  crmActivities              CrmActivity[]
  crossSellOpps              CrossSellOpportunity[]
  advisorCommissions         AdvisorCommission[]
  automationRules            AutomationRule[]
  automationPauses           AutomationPause[]
  automationLogs             AutomationLog[]
  agentTasks                 AgentTask[]
  insurancePolicies          InsurancePolicy[]
  insuranceClaims            InsuranceClaim[]
  premiumPayments            PremiumPayment[]
  insuranceProducts          InsuranceProduct[]
  insuranceRateTables        InsuranceRateTable[]
  insuranceEligibilityRules  InsuranceEligibilityRule[]
  insuranceQuotes            InsuranceQuote[]
  insuranceAdviceRecords     InsuranceAdviceRecord[]
  emailConfig                EmailConfig?
  integrationConfig          IntegrationConfig?
  messageTemplates           MessageTemplate[]
  branches                   Branch[]
  auditLogs                  AuditLog[]
  emailLogs                  EmailLog[]
  notificationLogs           NotificationLog[]
  integrationLogs            IntegrationLog[]
  creditBureauChecks         CreditBureauCheck[]
  statementAnalyses          StatementAnalysis[]
  applicationCheckFlags      ApplicationCheckFlag[]
  complianceRecords          ComplianceRecord[]
  consentRecords             ConsentRecord[]
  complaints                 Complaint[]
  dataSubjectRequests        DataSubjectRequest[]
  contacts                   Contact[]
  contactIdentities          ContactIdentity[]
  contactConsents            ContactConsent[]
  contactMerges              ContactMerge[]
  conversations              Conversation[]
  messages                   Message[]
  webhookSignatureFailures   WebhookSignatureFailure[]
  referralAgents             ReferralAgent[]
  referralCodes              ReferralCode[]
  referralEvents             ReferralEvent[]
  commsSettings              CommsSettings?
  websiteChatHandoffs        WebsiteChatHandoff[]
  cannedReplies              CannedReply[]
  documentTemplates          DocumentTemplate[]
  avsChecks                  AvsCheck[]
  bankStatementImports       BankStatementImport[]
  bankTransactions           BankTransaction[]
  notifications              Notification[]
  surrenderRequests          SurrenderRequest[]
  messageMentions            MessageMention[]
  loanCharges                LoanCharge[]
  bureauSubmissions          BureauSubmission[]
  bureauSubmissionRecords    BureauSubmissionRecord[]
  bureauAdverseConfirmations BureauAdverseConfirmation[]
  businessEntities           BusinessEntity[]
  referenceRates             ReferenceRate[]
  vatConfig                  VatConfig?
  taxInvoices                TaxInvoice[]
  leaseRentals               LeaseRental[]
  creditNotes                CreditNote[]
  entityDocuments            EntityDocument[]
  financedAssets             FinancedAsset[]
  suppliers                  Supplier[]
  assetFinanceDeals          AssetFinanceDeal[]
  kycOverrideRequests        KycOverrideRequest[]

  // Phase 9 launch-blocker gates. Default false — flipped only after the
  // tenant has the required legal opinion / Information Officer sign-off
  // captured in writing. See spec §Launch-blockers LB3, LB7.
  insuranceCrossSellS69OpinionReceived Boolean @default(false)
  softOptInClosedLoanTailEnabled       Boolean @default(false)
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PROVISIONING
}

model TenantConfig {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  primaryColor   String  @default("#4F46E5")
  secondaryColor String  @default("#4338CA")
  darkColor      String  @default("#0B0D12")
  logoUrl        String?
  faviconUrl     String?
  brandName      String?

  featureLms                       Boolean @default(true)
  featureCrm                       Boolean @default(false)
  featureIms                       Boolean @default(false)
  featureBureauSubmission          Boolean @default(false)
  featureMarketing                 Boolean @default(false)
  featurePortal                    Boolean @default(true)
  featureReports                   Boolean @default(true)
  // Asset finance (docs/asset-finance/DESIGN.md D9). Gate: lib/asset-finance/require-enabled.ts
  featureAssetFinance              Boolean @default(false)
  // Asset-finance payouts at or above this amount (cents) need a second,
  // different approver (DESIGN D8). Default R1m.
  assetPayoutDualApprovalCents     Int     @default(100000000)
  // Asset-finance agreements, suretyships and resolutions render with a
  // DRAFT — NOT FOR EXECUTION watermark until the lender's legal team approves
  // the wording. Turning this on is a Confirmation Gate (Hein / legal).
  assetFinanceLegalWordingApproved Boolean @default(false)

  ncrNumber        String?
  fscaNumber       String?
  companyRegNumber String?

  // Lender identity (lib/config/identity.ts). Written ONLY through
  // lib/config/identity-write.ts, which validates, demands the statutory
  // numbers twice on change, and audits. Nullable: an unconfigured tenant
  // makes every identity reader throw rather than print a default.
  legalName                 String?
  registeredOffice          String? // newline-separated address lines
  publicEmail               String?
  publicPhone               String?
  publicWhatsapp            String?
  collectionsEmail          String?
  collectionsPhone          String?
  collectionsPhoneSecondary String?
  brandTagline              String?
  // Regulatory details for the public regulatory-information page. Optional:
  // the page omits a line whose value is null.
  ncrRegistrationDate       DateTime? @db.Date
  fscaAuthorisationDate     DateTime? @db.Date
  ncrStatus                 String? // Registered | Suspended | Cancelled | Deregistered
  headOfficeCity            String?

  netcashKey       String?
  bulkSmsKey       String?
  transunionKey    String?
  smileIdentityKey String?

  informationOfficerUserId String?

  // Bureau DATA SUBMISSION (lib/bureau-submission). All three must be set
  // before a file is generated; the supplier number is issued by SACRRA.
  bureauSupplierNumber     String?
  bureauTradingName        String?
  bureauReportingStartDate DateTime? @db.Date

  bureauMinScore     Int     @default(450)
  bureauBlockAdverse Boolean @default(false)

  // Staff two-factor policy (lib/security/staff-totp-policy.ts). On: a staff
  // user with no TOTP enrolled can reach only the enrolment page. Off: a code
  // is demanded at sign-in only from a user who enrolled. Default on, for
  // existing rows too.
  requireStaffTotp Boolean @default(true)

  // Failed-selfie and in-person override policy (lib/kyc/override-policy.ts).
  // A clear biometric mismatch remains non-overridable regardless of these
  // settings; the database independently enforces that boundary.
  kycOverrideEnabled        Boolean  @default(true)
  kycOverrideMinRole        UserRole @default(ADMIN)
  kycOverrideSecondApprover Boolean  @default(false)

  // Phase 7 — collection engine. Dark by default.
  collectionsEngineEnabled Boolean @default(false)
  collectionProvider       String?
  avsProvider              String? // null = use collectionProvider's AVS
  netcashDebitOrderKey     String? // Netcash per-service keys (collections
  netcashRiskReportsKey    String? // + AVS); distinct from netcashKey (payouts)

  ndiBufferPct Int @default(110)

  referralCommissionBps Int @default(0) // agent commission rate, basis points (200 = 2.00%); 0 = off

  bankSyncEnabled             Boolean @default(false)
  absaAccountNumberMasked     String?
  absaAutoApplyHighConfidence Boolean @default(false)

  // Default interest and post-default charges (lib/loan/default-charges.ts).
  // Dark by default: while false no charge is derived and every receipt path
  // behaves exactly as it did before the feature existed.
  defaultChargesEnabled    Boolean   @default(false)
  defaultAdminChargeCents  Int       @default(8200) // per Section 129 notice issued
  defaultAdminPostageCents Int       @default(0)
  // Go-live instant, set (audited) by the first back-fill --apply. The flag
  // without it posts nothing; no charge accrues on a day before it, and a loan
  // current at go-live is never back-charged (lib/loan/charges-replay.ts).
  defaultChargesStartedAt  DateTime?
  // When --disable stopped charges (audited). One-way: from then on nothing
  // is derived for the tenant and --apply refuses to re-enable.
  defaultChargesStoppedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  LOAN_ADMIN
  CREDIT_OFFICER
  COLLECTIONS_OFFICER
  COLLECTIONS_AGENT
  INSURANCE_OFFICER
  BRANCH_MANAGER
  READONLY
}

model LoginLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
}

// Sign-in attempts that did NOT match a known user (or where logging to
// LoginLog isn't possible because LoginLog.userId is non-nullable). Used
// for credential-stuffing detection and POPIA breach audits.
model FailedLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  userAgent String?
  reason    String // unknown_email | wrong_password | totp_invalid | rate_limited
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ip])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  // Stamped by lib/auth.ts on every successful TOTP check. Backs the
  // "fresh-2FA within N minutes" gate on voice-token mint (Phase 9 §Twilio
  // voice integration). Null on sessions that have never re-asserted TOTP.
  lastTotpAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

