  // Trusts: the Master of the High Court reference (IT number).
  mastersReference      String?
  vatNumber             String?
  // NCA classifier inputs (cents), the financial year they describe and the
  // document ids that evidence them. Unevidenced → the classifier says NCA.
  annualTurnover        BigInt?
  totalAssetValue       BigInt?
  financialYearEnd      DateTime?            @db.Date
  financialsEvidenceIds String[]             @default([])
