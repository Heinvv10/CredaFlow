enum DocumentTemplateKind {
  SYSTEM
  CUSTOM
  // A lender's own asset-finance legal wording (lib/asset-finance/documents/templates).
  ASSET_FINANCE
}

// What an ASSET_FINANCE version's approval is. Derived from
// TenantConfig.isDemoLender, never posted: a demo lender's approval is
// SYNTHETIC_DEMO and its documents keep a demo watermark; a real lender's is
// LENDER_LEGAL with its legal sign-off reference. The database refuses either
// on the other kind of tenant.
enum DocumentTemplateApprovalBasis {
  SYNTHETIC_DEMO
  LENDER_LEGAL
}

enum DocumentTemplateVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentSigningMethod {
  NONE
  NATIVE
  SIGNUM
}

model DocumentTemplate {
  id               String                    @id @default(cuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id])
  key              String // stable slug, e.g. "settlement_letter"
  name             String
  category         String? // "Agreement" | "Collections" | "Consent" | ...
  kind             DocumentTemplateKind
  systemGenerator  String? // SYSTEM only: which lib/pdf module, e.g. "creditAgreement"
  signingMethod    DocumentSigningMethod     @default(NONE)
  requiresApproval Boolean                   @default(false) // CUSTOM legal docs → dual-approval before ACTIVE
  isActive         Boolean                   @default(true)
  currentVersionId String? // CUSTOM: FK to the ACTIVE version
  createdById      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?
  // ASSET_FINANCE only: key = "<assetFamily>.<assetVariant>" (lib/asset-finance/documents/templates/families.ts).
  assetFamily      String?
  assetVariant     String?
  issuances        AssetDocumentIssuance[]
  loanIssuances    LoanDocumentIssuance[]
  versions         DocumentTemplateVersion[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model DocumentTemplateVersion {
  id            String                        @id @default(cuid())
  templateId    String
  template      DocumentTemplate              @relation(fields: [templateId], references: [id])
  version       Int
  bodyHtml      String // authored HTML containing {{tokens}}
  tokensUsed    Json // tokens referenced — for validation + preview
  status        DocumentTemplateVersionStatus @default(DRAFT)
  notes         String?
  createdById   String?
  createdAt     DateTime                      @default(now())
  activatedById String?
  activatedAt   DateTime?
  approvedById  String? // dual-approval (second LOAN_ADMIN)
  approvedAt    DateTime?
  // ASSET_FINANCE only. `content` is the canonical JSON of the lender wording;
  // the database checks contentSha256 against it and keeps both immutable. An
  // approval binds approvedContentSha256 (= contentSha256) and its basis.
  content               String?
  contentSha256         String?
  approvalBasis         DocumentTemplateApprovalBasis?
  approvedContentSha256 String?
  // The fingerprint of the protected system output of this variant when it was
  // approved (lib/asset-finance/documents/templates/fingerprint.ts): an
  // approval covers the protected wording too, and lapses when it changes.
  approvedSystemSha256  String?
  legalSignOffReference String?
  issuances             AssetDocumentIssuance[]
  loanIssuances         LoanDocumentIssuance[]

  @@unique([templateId, version])
  @@index([templateId])
}

enum SigningOtpPurpose {
  AGREEMENT
  DEBIT_MANDATE
  DOCUMENT
  // An asset-finance deal document (DealSigner row): agreement, suretyship,
  // resolution. subjectId is the DealSigner id.
  DEAL_DOCUMENT
}

// One borrower signing OTP (lib/signing-otp). Bound to the client, the thing
// being signed (subjectId: the application for AGREEMENT / DEBIT_MANDATE, the
// ClientDocument for DOCUMENT) and the SHA-256 of the exact bytes shown. The
// code is stored only as a keyed hash. Consumed once, inside the signing
// transaction; from then on the row is the OTP evidence of that signature and
// the database refuses to change or delete it.
model SigningOtpChallenge {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  clientId          String
  client            Client            @relation(fields: [tenantId, clientId], references: [tenantId, id])
  purpose           SigningOtpPurpose
  subjectId         String
  documentSha256    String
  codeHash          String
  channel           Channel
  maskedDestination String
  deliveryStatus    String // PENDING (before the send) | ACCEPTED | SIMULATED | FAILED
  sentAt            DateTime?
  expiresAt         DateTime
  attempts          Int               @default(0)
  maxAttempts       Int
  verifiedAt        DateTime?
  consumedAt        DateTime?
  signingMethod     String? // portal | branch, set at consumption
  requestedByUserId String? // the staff witness for a branch request
  requestedIp       String?
  createdAt         DateTime          @default(now())

  @@index([tenantId, clientId, purpose, subjectId, createdAt])
}
