// ── Learning loop: decision log (docs/learning-loop/DESIGN.md) ───────────────
// One append-only row per decision EVENT: a credit decision (approve, decline,
// refer, return to review or draft, a credit-check flag cleared), an offer
// (the approved terms, the PASQ issued at signing) or, later, a collection
// action. It records what the gates said (recommendation), what was decided
// and by whom, and whether the person went against a gate (overridden, with
// the reason). Inputs are a minimised, banded snapshot built from an explicit
// allow-list (lib/learning-loop/), plus references to the source of record and
// a sha256 of the exact inputs. Subject ids carry no foreign key: the row
// outlives nothing it points at, and a SET NULL would be an UPDATE the
// append-only trigger refuses. Outcomes attach to it later (PR B).

enum DecisionRecordKind {
  CREDIT_DECISION
  OFFER
  COLLECTION_ACTION
}

/// What the existing gates said before the person decided. NONE: no gate was
/// evaluated for this event (a decline, a return, a refer).
enum DecisionRecommendation {
  PASS
  BLOCK
  REFER
  NONE
}

/// SYSTEM is an automated decision (POPIA s71); STAFF needs actorUserId.
enum DecisionActorType {
  STAFF
  SYSTEM
  CLIENT
}

model CreditDecisionRecord {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  kind                 DecisionRecordKind
  /// APPROVE, DECLINE, REFER, RETURN_TO_REVIEW, RETURN_TO_DRAFT, CLEAR_FLAG,
  /// APPROVED_TERMS, QUOTATION_ISSUED (lib/learning-loop/decision-log.ts).
  decision             String
  recommendation       DecisionRecommendation
  /// The person decided against a gate; overrideReason says why.
  overridden           Boolean
  overrideReason       String?
  actorType            DecisionActorType
  actorUserId          String?
  actorRole            String?
  applicationId        String?
  loanId               String?
  clientId             String?
  /// A website Lead: the only subject an identity-conflict refusal can name (no client is confirmed).
  leadId               String?
  /// The row of record the decision changed (LoanApplication, ApplicationCheckFlag, AssetFinanceDeal).
  sourceEntityType     String
  sourceEntityId       String
  /// Code rule version, e.g. "decision-log-v1+approval-ndi-v3".
  ruleVersion          String
  /// sha256 of the tenant's effective decision thresholds at decision time.
  policyHash           String                 @db.Char(64)
  /// A scoring model's version. Null: no model decides or recommends today.
  modelVersion         String?
  /// 0..1. Null unless a model produced a probability; calibration reads only rows that carry one.
  predictedProbability Decimal?               @db.Decimal(6, 5)
  /// Minimised, banded inputs (allow-list; no identifiers, contacts, bank details or bureau payloads).
  inputsSnapshot       Json
  /// Ids and fingerprints of the evidence of record (bureau check, affordability snapshot, flags).
  evidenceRefs         Json
  /// sha256 of the canonical JSON of the exact inputs (lib/canonical-json.ts).
  inputsHash           String                 @db.Char(64)
  /// An automated (SYSTEM) decision awaiting the lender's POPIA s71 legal review
  /// (DESIGN.md decision 5; DB CHECK: only on SYSTEM rows).
  s71ReviewRequired    Boolean                @default(false)
  decidedAt            DateTime
  createdAt            DateTime               @default(now())

  outcomes DecisionOutcome[]

  @@unique([tenantId, id])
  @@index([tenantId, applicationId])
  @@index([tenantId, loanId])
  @@index([tenantId, kind, decidedAt])
}

// ── Learning loop: outcomes (docs/learning-loop/DESIGN.md §3-§4) ─────────────
// What later happened to a decision, derived nightly from the servicing
// tables (/api/cron/decision-outcomes, lib/learning-loop/outcomes/). Not
// append-only: every row is recomputable, each run converges on the key, and a
// definition change bumps definitionVersion and recomputes.

/// DESIGN.md §3. The headline "bad" is EVER_90_DPD in window 12M. An offer's
/// NOT_TAKEN_UP is TAKEN_UP with value false (one row per offer, so a resolved
/// offer never leaves a stale row behind).
enum DecisionOutcomeKind {
  PAID
  LATE
  RETURNED_DEBIT_ORDER
  EVER_30_DPD
  EVER_60_DPD
  EVER_90_DPD
  DEFAULTED_STATUS
  /// Back to 0 DPD after 30+ while the loan is still open (settling is not a cure).
  CURED
  /// Settled (COMPLETED) after 30+ DPD in the window: its own outcome, never a cure.
  SETTLED_AFTER_DELINQUENCY
  SETTLED
  WRITTEN_OFF
  TAKEN_UP
}

/// PENDING: the window has not elapsed. UNOBSERVABLE: it has, but part of the
/// history is missing (never read as a good outcome). Only OBSERVED carries a value.
enum DecisionOutcomeState {
  OBSERVED
  PENDING
  UNOBSERVABLE
}

model DecisionOutcome {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  decisionRecordId  String
  decisionRecord    CreditDecisionRecord @relation(fields: [tenantId, decisionRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  outcomeKind       DecisionOutcomeKind
  /// 3M, 6M, 12M (from the first instalment due date), TERM_30D, OFFER or INSTALMENT:<n>.
  window            String
  state             DecisionOutcomeState
  /// Set exactly when OBSERVED.
  value             Boolean?
  /// Cents: the instalment or the returned debit order.
  amountCents       Int?
  /// A returned debit order's CollectionReasonCode; why a row is UNOBSERVABLE; CURED's NEVER_30_DPD.
  reasonCode        String?
  /// credaflow or external_extract.
  sourceSystem      String
  /// Opaque: a loan, schedule row, CollectionResult or application id, or an extract row key.
  sourceRef         String
  /// The code definition that produced the row (lib/learning-loop/outcomes/definition.ts).
  definitionVersion String
  /// When the observed fact happened. Set exactly when OBSERVED.
  observedAt        DateTime?
  /// When this content was computed; a run that changes nothing leaves it.
  computedAt        DateTime
  /// Derived on a demo lender (TenantConfig.isDemoLender), where simulated
  /// collection results count: shown only under a "Simulated / demo data"
  /// label, never in a real lender's figures (DESIGN.md decision 4).
  demoData          Boolean              @default(false)

  @@unique([decisionRecordId, outcomeKind, window, sourceSystem, sourceRef])
  @@index([tenantId, outcomeKind, window, state])
}
