}

model TenantConfig {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  primaryColor   String  @default("#4F46E5")
  secondaryColor String  @default("#4338CA")
  darkColor      String  @default("#0B0D12")
  logoUrl        String?
  faviconUrl     String?
  brandName      String?

  featureLms                        Boolean @default(true)
  featureCrm                        Boolean @default(false)
  featureIms                        Boolean @default(false)
  featureBureauSubmission           Boolean @default(false)
  featureMarketing                  Boolean @default(false)
  featurePortal                     Boolean @default(true)
  featureReports                    Boolean @default(true)
  // Asset finance (docs/asset-finance/DESIGN.md D9). Gate: lib/asset-finance/require-enabled.ts
  featureAssetFinance               Boolean @default(false)
  // Dealer/broker portal (docs/asset-finance/SLICE5.md part A). Demo lenders
  // only until dealer 2FA ships (CHECK TenantConfig_dealer_portal_demo_only).
  featureDealerPortal               Boolean @default(false)
  // Months after booking in which commission is clawed back when the loan
  // settles early or is written off; 0 = off (CHECK 0..60).
  dealerCommissionClawbackMonths    Int     @default(0)
  // Statement AI (lib/statement-ai): advisory summaries, flag explanations and
  // answers from the self-hosted model. Priced per statement; only a
  // SUPER_ADMIN switches it (app/api/settings/statement-ai), audited.
  featureStatementAi                Boolean @default(false)
  // Asset-finance payouts at or above this amount (cents) need a second,
  // different approver (DESIGN D8). Default R1m.
  assetPayoutDualApprovalCents      Int     @default(100000000)
  // Leases (slice 3): a maintenance claim at or above this amount (ex VAT,
  // cents) needs a second approver; a purchase at the end of the term needs a
  // valuation no older than this many days; an early-termination quote is
  // valid this many days.
  maintenanceClaimDualApprovalCents Int     @default(5000000)
  leasePurchaseValuationMaxAgeDays  Int     @default(30)
  leaseTerminationQuoteValidDays    Int     @default(10)
  // Telematics (docs/asset-finance/SLICE5.md part B): days a tracker position
  // is kept before the nightly purge (CHECK 1..365; longer needs legal sign-off).
  telematicsPositionRetentionDays   Int     @default(90)

  // Recovery and remarketing (slice 4a, UNTESTED: lender legal sign-off). The
  // cost types an NCA recovery may deduct from sale proceeds, and the types a
  // NON_NCA recovery may deduct or charge; the days a NON_NCA debtor has after
  // the proceeds before charges resume.
  recoveryNcaDeductibleCostTypes    RecoveryCostType[] @default([TOWING, STORAGE, VALUATION, REPAIRS, ADVERTISING, AUCTION_COMMISSION, SHERIFF, INSURANCE])
  recoveryNonNcaChargeableCostTypes RecoveryCostType[] @default([TOWING, STORAGE, VALUATION, REPAIRS, ADVERTISING, AUCTION_COMMISSION, SHERIFF, INSURANCE, LEGAL_TAXED, LEGAL_CONTRACTUAL, OTHER])
  nonNcaDemandPeriodDays            Int                @default(10)
  // Asset-finance agreements, suretyships and resolutions render with a
  // DRAFT — NOT FOR EXECUTION watermark until the lender's legal team approves
  // the wording. Turning this on is a Confirmation Gate (Hein / legal).
  assetFinanceLegalWordingApproved  Boolean            @default(false)

  ncrNumber        String?
  fscaNumber       String?
  companyRegNumber String?

  // Lender identity (lib/config/identity.ts). Written ONLY through
  // lib/config/identity-write.ts, which validates, demands the statutory
  // numbers twice on change, and audits. Nullable: an unconfigured tenant
  // makes every identity reader throw rather than print a default.
  legalName                 String?
  registeredOffice          String? // newline-separated address lines
  publicEmail               String?
  publicPhone               String?
  publicWhatsapp            String?
  collectionsEmail          String?
  collectionsPhone          String?
  collectionsPhoneSecondary String?
  brandTagline              String?
  // Regulatory details for the public regulatory-information page. Optional:
  // the page omits a line whose value is null.
  ncrRegistrationDate       DateTime? @db.Date
  fscaAuthorisationDate     DateTime? @db.Date
  ncrStatus                 String? // Registered | Suspended | Cancelled | Deregistered
  headOfficeCity            String?

  // Provider credentials. Every *Key / *Secret column below holds a value
  // sealed by lib/crypto/secret-box.ts (enc:v1:…); lib/integrations/
  // tenant-credentials.ts is the only reader and writer. Pairs are stored as
  // "id:secret" (bulkSms user:password, transunion clientId:clientSecret,
  // smileIdentity partnerId:apiKey, experian username:password, stitch
  // clientId:clientSecret).
  netcashKey            String?
  bulkSmsKey            String?
  transunionKey         String?
  smileIdentityKey      String?
  experianKey           String?
  stitchKey             String?
  stitchWebhookSecret   String?
  // The lender's own collection account Stitch pays into. Not secret.
  stitchBeneficiaryName String?
  stitchBankId          String?
  stitchAccountNumber   String?
  stitchBranchCode      String?

  informationOfficerUserId String?

  // Bureau DATA SUBMISSION (lib/bureau-submission). All three must be set
  // before a file is generated; the supplier number is issued by SACRRA.
  bureauSupplierNumber     String?
  bureauTradingName        String?
  bureauReportingStartDate DateTime? @db.Date

  bureauMinScore     Int     @default(450)
  bureauBlockAdverse Boolean @default(false)

  // Credit bureau ENQUIRY (lib/bureau). The ordered list is the whole policy:
  // the first entry is the primary, the rest the fallback order, and a bureau
  // not listed is not enabled. The default reproduces the Experian-only path.
  bureauProviderOrder String[] @default(["experian"])
  // Credentials for the bureaus that keep them per tenant: ONE secret-box
  // sealed JSON object keyed by provider id (lib/bureau/credentials.ts).
  bureauCredentials   String?
  // How old a bureau report may be and still support approval, agreement and
  // payout. CHECK 1..60 in the migration (60 = BUREAU_STALENESS_DAYS, the
  // ceiling in lib/compliance/bureau.ts).
  bureauMaxAgeDays    Int      @default(60)

  // Staff two-factor policy (lib/security/staff-totp-policy.ts). On: a staff
  // user with no TOTP enrolled can reach only the enrolment page. Off: a code
  // is demanded at sign-in only from a user who enrolled. Default on, for
  // existing rows too.
  requireStaffTotp Boolean @default(true)

  // Credit decision log retention (lib/learning-loop/retention/). null = off,
  // and there is no default: nothing is pseudonymised until the lender sets a
  // period in months (CHECK 60..600). Changed only by a SUPER_ADMIN in a
  // TOTP-verified session, audited.
  decisionRecordRetentionMonths Int?

  // Segregation of duties (lib/security/segregation-of-duties.ts). On: the
  // approver of an application cannot disburse it, the staff witness of an
  // in-branch consumer signature cannot countersign it, and every asset-finance
  // payout needs a second approver. The database triggers read it. Changed only
  // by ADMIN or SUPER_ADMIN, audited. Default on, for existing rows too.
  requireSegregationOfDuties Boolean @default(true)

  // Failed-selfie and in-person override policy (lib/kyc/override-policy.ts).
  // A clear biometric mismatch remains non-overridable regardless of these
  // settings; the database independently enforces that boundary.
  kycOverrideEnabled        Boolean  @default(true)
  kycOverrideMinRole        UserRole @default(ADMIN)
  kycOverrideSecondApprover Boolean  @default(false)

  // PEP / sanctions screening (lib/screening). null = not configured: no
  // screening runs and the approval gate passes, as before the module existed.
  // Otherwise a key from lib/screening/registry.ts. Matches that need a human
  // are cleared by a reviewer at or above screeningReviewMinRole
  // (BRANCH_MANAGER or ADMIN), with TOTP when requireStaffTotp is on.
  screeningProvider      String?
  screeningReviewMinRole UserRole @default(ADMIN)
  // Maker-checker for screening decisions, STR decisions and RMCP approvals
  // (the database triggers read it). Changed only by a SUPER_ADMIN with TOTP.
  requireSecondReviewer  Boolean  @default(true)
  // Borrower signing OTP (lib/signing-otp). Portal signing of the agreement,
  // debit mandate and other documents needs a verified one-time code when
  // requireSigningOtp is on; branch signing (staff present) is exempt while
  // signingOtpBranchExempt is on.
  requireSigningOtp      Boolean  @default(true)
  signingOtpBranchExempt Boolean  @default(true)
  // Portal self-registration (app/api/portal/register). Off refuses new
  // activations; clients who already activated are unaffected.
  allowNewRegistrations  Boolean  @default(true)
  // Staff access restrictions (lib/security/staff-access-policy.ts). Hours:
  // null = any time, else per-weekday SAST windows. Allowlist: empty = any
  // address, else CIDR blocks the staff caller's IP must fall in.
  staffAccessHours       Json?
  staffIpAllowlist       String[] @default([])

  // Phase 7 — collection engine. Dark by default.
  collectionsEngineEnabled Boolean @default(false)
  collectionProvider       String?
  avsProvider              String? // null = use collectionProvider's AVS
  netcashDebitOrderKey     String? // Netcash per-service keys (collections
  netcashRiskReportsKey    String? // + AVS); distinct from netcashKey (payouts)

  // W6 payout channels (lib/payouts). Off = the disburse route behaves exactly
  // as before: it records the payout and calls no provider.
  payoutsEngineEnabled Boolean @default(false)
  payoutProvider       String? // lib/payouts/registry.ts provider id

  ndiBufferPct Int @default(110)

  // Languages the borrower-facing surfaces (website, portal, comms) may use
  // (lib/i18n). English only by default: the other catalogues are machine
  // drafts until a native speaker has reviewed them for this lender. Always
  // contains "en" (the admin API refuses a list without it).
  enabledLanguages String[] @default(["en"])
  // Per language, the acknowledgement that a native speaker reviewed its
  // catalogue: { "<locale>": { reviewer, acknowledgedAt, acknowledgedById,
  // acknowledgedByEmail } } (lib/i18n/language-reviews.ts). Enabling af/zu/xh
  // requires one, and a language without one is not served.
  languageReviews  Json     @default("{}")

  referralCommissionBps Int @default(0) // agent commission rate, basis points (200 = 2.00%); 0 = off

  bankSyncEnabled             Boolean @default(false)
  absaAccountNumberMasked     String?
  absaAutoApplyHighConfidence Boolean @default(false)

  // Default interest and post-default charges (lib/loan/default-charges.ts).
  // Dark by default: while false no charge is derived and every receipt path
  // behaves exactly as it did before the feature existed.
  defaultChargesEnabled    Boolean   @default(false)
  defaultAdminChargeCents  Int       @default(8200) // per Section 129 notice issued
  defaultAdminPostageCents Int       @default(0)
  // Go-live instant, set (audited) by the first back-fill --apply. The flag
  // without it posts nothing; no charge accrues on a day before it, and a loan
  // current at go-live is never back-charged (lib/loan/charges-replay.ts).
  defaultChargesStartedAt  DateTime?
  // When --disable stopped charges (audited). One-way: from then on nothing
  // is derived for the tenant and --apply refuses to re-enable.
  defaultChargesStoppedAt  DateTime?

  // A synthetic demo lender. Set only by the demo seed (prisma/seed.ts) and
  // the demo stack scripts (TENANT_DEMO_LENDER_SQL, scripts/demo/lib.sh);
  // provisioning refuses it (scripts/lender/bootstrap-tenant.ts) and no route
  // writes it. On a DEMO_MODE stack it lets a Section 129 notice to an
  // undeliverable mailbox be simulated (lib/collections/section129-email.ts).
  isDemoLender Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

