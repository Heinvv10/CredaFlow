// ── Credit checks v1 (lib/statement-analysis, lib/credit-checks) ──────────────
// A statement read is evidence, not a decision: the checks raise REFER flags a
// LOAN_ADMIN clears with a reason. The approval trigger and the clearance
// CHECK are hand-written in migration 20261013120000_credit_checks_v1.

enum StatementReadMethod {
  TEXT
  VLM
}

enum StatementReadStatus {
  READ
  UNREADABLE
  UNSUPPORTED
}

enum BalanceCheck {
  PASS
  FAIL
  NOT_APPLICABLE
}

/// One read of one ClientDocument's exact bytes by one parser version.
model StatementAnalysis {
  id                     String              @id @default(cuid())
  tenantId               String
  tenant                 Tenant              @relation(fields: [tenantId], references: [id])
  clientDocumentId       String
  clientDocument         ClientDocument      @relation(fields: [clientDocumentId], references: [id])
  contentSha256          String
  parserVersion          String
  method                 StatementReadMethod
  status                 StatementReadStatus
  bank                   String?
  accountHolderName      String?
  accountNumberLast4     String?
  periodStart            DateTime?
  periodEnd              DateTime?
  openingBalanceCents    BigInt?
  closingBalanceCents    BigInt?
  /// [{date, description, amountCents, balanceCents, page}]: cents as JSON numbers
  transactions           Json
  balanceCheck           BalanceCheck
  balanceDiffCents       BigInt?
  /// {producer, creator, createdAt, modifiedAt, incrementalUpdates, signals[]}
  authenticity           Json
  /// {labelKey: Category}: the local model's category for each masked debit key
  /// the rules left UNCATEGORISED (lib/statement-analysis/model-labels.ts).
  /// Applied on read after the rules; null until the model has labelled this read.
  modelCategories        Json?
  /// "<model>|<prompt version>" the labels came from
  modelCategoriesVersion String?
  modelCategoriesAt      DateTime?
  createdAt              DateTime            @default(now())

  @@unique([clientDocumentId, contentSha256, parserVersion])
  @@index([tenantId])
}

enum CreditCheck {
  DOCUMENT_AUTHENTICITY
  SALARY_MATCH
  UNDISCLOSED_DEBT
  RISK_BEHAVIOUR
  MANUAL_REVIEW
  EXPENSE_UNDERSTATED
}

enum CheckFlagStatus {
  OPEN
  CLEARED
  SUPERSEDED
}

/// A REFER flag on an application. An OPEN flag blocks approval, in the decide
/// route and in the LoanApplication approval trigger.
model ApplicationCheckFlag {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  applicationId String
  application   LoanApplication @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  check         CreditCheck
  code          String
  fingerprint   String
  status        CheckFlagStatus @default(OPEN)
  summary       String
  evidence      Json
  raisedAt      DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  clearedById   String?
  clearedBy     User?           @relation("CheckFlagClearedBy", fields: [tenantId, clearedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  clearedAt     DateTime?
  clearReason   String?

  @@unique([applicationId, fingerprint])
  @@index([tenantId, applicationId, status])
}

// ── Statement AI (lib/statement-ai) ──────────────────────────────────────────
// Advisory text from the self-hosted model beside the statement insights: a
// summary, a plain-language explanation per raised flag, and answers to an
// officer's question. Never read by the checks, the recompute or the decide
// route; a post-check rejects any output with a figure it was not given.

enum StatementAiKind {
  SUMMARY
  FLAG_EXPLANATION
  ANSWER
}

enum StatementAiStatus {
  /// An asked question waiting for the background worker.
  PENDING
  OK
  REJECTED
  FAILED
}

/// One model output for one application, keyed by what it was made from.
model StatementAiOutput {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  applicationId String
  application   LoanApplication   @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  kind          StatementAiKind
  /// The flag explained ("" for a summary or an answer: Postgres treats NULLs
  /// as distinct, so a nullable column would not hold the unique key).
  flagCode      String            @default("")
  /// sha256 of the facts (and question) the model was given.
  inputHash     String
  promptVersion String
  status        StatementAiStatus
  rejectReason  String?
  /// Shown only when status is OK.
  text          String            @default("")
  /// Tool calls and their results (ANSWER), or the facts cited (SUMMARY, FLAG_EXPLANATION).
  citations     Json              @default("[]")
  /// ANSWER only: the officer's question and who asked it.
  question      String?
  askedById     String?
  askedBy       User?             @relation("StatementAiAskedBy", fields: [tenantId, askedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([tenantId, applicationId, kind, flagCode, inputHash, promptVersion])
  @@index([tenantId, applicationId, kind, createdAt])
}

/// One call to the model, for per-statement pricing. Metering only: it never blocks a call.
model StatementAiUsage {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  applicationId String
  kind          StatementAiKind
  /// What the model server reported; null when it reported none.
  tokensIn      Int?
  tokensOut     Int?
  latencyMs     Int
  createdAt     DateTime        @default(now())

  @@index([tenantId, createdAt])
}
