enum CollectionsStage {
  NONE
  SOFT_REMINDER
  FORMAL_REMINDER
  SECTION_129_SENT
  PAYMENT_ARRANGEMENT
  ATTORNEY_REFERRED
  WRITTEN_OFF
}

model PaymentArrangement {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  loanId          String   @unique
  loan            Loan     @relation(fields: [loanId], references: [id])
  arrangementDate DateTime
  agreedAmount    Int
  frequency       String // WEEKLY, BIWEEKLY, MONTHLY
  startDate       DateTime
  endDate         DateTime
  notes           String?
  status          String   @default("ACTIVE") // ACTIVE, KEPT, BROKEN, COMPLETED
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model AttorneyFirm {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  specialisation String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  referrals      AttorneyReferral[]

  @@index([tenantId, active])
}

model AttorneyReferral {
  id            String        @id @default(cuid())
  loanId        String        @unique
  loan          Loan          @relation(fields: [loanId], references: [id])
  firmId        String?
  firm          AttorneyFirm? @relation(fields: [firmId], references: [id])
  firmName      String
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  referralDate  DateTime
  matterNumber  String?
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Phase 7 — collection engine. Bank-account verification
// result, persisted for audit; gated behind TenantConfig.collectionsEngineEnabled.
model AvsCheck {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id])
  applicationId      String?
  subjectFingerprint String?
  provider           String
  accountHolder      String
  bankName           String
  branchCode         String
  accountNumber      String
  accountType        String
  passed             Boolean
  checks             Json // AvsChecks shape; null members = not returned by provider
  raw                Json?
  checkedById        String?
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@index([clientId, createdAt])
}

// ── Collections engine (W2) ─────────────────────────────────────────────────
// DebiCheck / debit-order mandates and collections, provider-agnostic
// (lib/collections-engine; adapters in lib/integrations/collections). Dark
// unless TenantConfig.collectionsEngineEnabled. The hard scheme rules are also
// enforced by migration 20261014150000_collections_engine: the presentment cap
// per instalment (CHECK + unique, across mandates), one live mandate per loan,
// the mandate status transitions, instructions only against an ACTIVE mandate,
// and idempotent result ingestion (unique resultKey). Kept as one block:
// append, don't interleave.

enum DebitMandateStatus {
  CREATED
  /// Claimed by one writer for the provider call (staff create vs cron).
  SUBMITTING
  /// Uploaded to a file-based rail; awaiting its registration / load report.
  PENDING_REGISTRATION
  PENDING_AUTH
  ACTIVE
  REJECTED
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum DebitMandateAuthType {
  TT1
  TT1_DELAYED
  TT2
}

enum DebitMandateFrequency {
  ONCE_OFF
  MONTHLY
}

/// DebiCheck amount-adjustment category agreed with the debtor.
enum DebitMandateAdjustment {
  NEVER
  QUARTERLY
  BIANNUALLY
  ANNUALLY
  REPO_RATE
}

enum CollectionBatchStatus {
  SUBMITTING
  /// Uploaded to a file-based rail; awaiting its load report.
  UPLOADED
  SUBMITTED
  FAILED
  /// The provider's answer is unknown; see its instructions.
  NEEDS_REVIEW
}

enum CollectionInstructionStatus {
  PENDING
  SUBMITTING
  /// In a batch the provider received; awaiting its load report.
  UPLOADED
  SUBMITTED
  /// May or may not have reached the bank: a person decides (never re-sent automatically).
  NEEDS_REVIEW
  REJECTED
  CANCELLED
  PAID
  UNPAID
  DISPUTED
}

enum CollectionResultOutcome {
  PAID
  UNPAID
  DISPUTED
}

/// Mirrors NormalizedReason in lib/integrations/collections/types.ts.
enum CollectionReasonCode {
  INSUFFICIENT_FUNDS
  ACCOUNT_CLOSED
  PAYMENT_STOPPED
  MANDATE_SUSPENDED
  MANDATE_CANCELLED
  ACCOUNT_FROZEN
  NO_DEBIT_FACILITY
  NOT_FICA
  UNKNOWN
}

/// One DebiCheck / debit-order mandate for a loan. The bank account is a
/// snapshot: the mandate binds the account the debtor authorised, not whatever
/// the client record says later.
model DebitMandate {
  id                        String                 @id @default(cuid())
  tenantId                  String
  loanId                    String
  clientId                  String
  provider                  String
  providerMandateRef        String?
  authType                  DebitMandateAuthType
  status                    DebitMandateStatus     @default(CREATED)
  statusReason              String?
  statusChangedAt           DateTime               @default(now())
  amountCents               Int
  maxAmountCents            Int
  debitDay                  Int
  frequency                 DebitMandateFrequency
  adjustment                DebitMandateAdjustment @default(NEVER)
  trackingDays              Int
  firstCollectionDate       DateTime               @db.Date
  accountHolder             String
  bankName                  String
  branchCode                String
  accountNumber             String
  accountType               String
  /// Created against the simulated provider: no bank ever saw it.
  simulated                 Boolean                @default(false)
  /// Failed provider submissions; retried with backoff until the limit, then reviewReason.
  submitAttempts            Int                    @default(0)
  nextAttemptAt             DateTime?
  /// Set when the engine stops retrying and a person must act.
  reviewReason              String?
  /// When the provider confirmed the mandate cancelled (suspension, closure, staff).
  providerCancelledAt       DateTime?
  /// First claim for a provider call: from then on the provider may hold this
  /// mandate even without a reference here, so a cancellation must find it there.
  providerContactedAt       DateTime?
  /// The provider reported this ACTIVE mandate SUSPENDED once; applied only if the next refresh says so again.
  providerSuspendReportedAt DateTime?
  createdById               String
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id])
  loan         Loan                    @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  client       Client                  @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User                    @relation("DebitMandatesCreated", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  instructions CollectionInstruction[]

  @@unique([tenantId, id])
  @@unique([tenantId, provider, providerMandateRef])
  @@index([tenantId, loanId])
  @@index([tenantId, status])
}

/// One submission to the provider: every instruction sharing an action date.
model CollectionBatch {
  id               String                @id @default(cuid())
  tenantId         String
  provider         String
  providerBatchRef String?
  actionDate       DateTime              @db.Date
  status           CollectionBatchStatus @default(SUBMITTING)
  instructionCount Int
  totalCents       Int
  acceptedCount    Int                   @default(0)
  rejectedCount    Int                   @default(0)
  error            String?
  simulated        Boolean               @default(false)
  submittedAt      DateTime?
  createdAt        DateTime              @default(now())

  tenant       Tenant                  @relation(fields: [tenantId], references: [id])
  instructions CollectionInstruction[]

  @@unique([tenantId, id])
  @@unique([tenantId, provider, providerBatchRef])
  @@index([tenantId, createdAt])
}

/// One presentment of one instalment. presentmentNo counts the presentments of
/// that instalment across every mandate (scheme cap 2; a fresh mandate does not reset it).
model CollectionInstruction {
  id                  String                      @id @default(cuid())
  tenantId            String
  mandateId           String
  loanId              String
  repaymentScheduleId String
  installmentNo       Int
  presentmentNo       Int
  amountCents         Int
  actionDate          DateTime                    @db.Date
  trackingDays        Int
  instructionRef      String
  status              CollectionInstructionStatus @default(PENDING)
  statusReason        String?
  batchId             String?
  submittedAt         DateTime?
  /// A REJECTED instruction stays in the review queue until staff acknowledge it.
  reviewResolvedAt    DateTime?
  /// Released for sending again after its fate was unknown: a later repeat PAID may be a second, real debit.
  releasedAt          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  mandate           DebitMandate       @relation(fields: [tenantId, mandateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  loan              Loan               @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  repaymentSchedule RepaymentSchedule  @relation(fields: [tenantId, repaymentScheduleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  batch             CollectionBatch?   @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  results           CollectionResult[]

  @@unique([tenantId, id])
  @@unique([tenantId, instructionRef])
  @@index([tenantId, status, actionDate])
  @@index([tenantId, loanId])
  @@index([mandateId])
}

/// A provider outcome for one instruction. resultKey is unique per provider,
/// so ingesting the same outcome twice is a no-op.
model CollectionResult {
  id                   String                  @id @default(cuid())
  tenantId             String
  provider             String
  instructionId        String
  resultKey            String
  outcome              CollectionResultOutcome
  reasonCode           CollectionReasonCode?
  rawCode              String?
  rawPayload           Json
  settledAmountCents   Int?
  resolvedAt           DateTime
  simulated            Boolean                 @default(false)
  paymentId            String?
  /// When the engine finished acting on it (allocated, or recorded why not).
  processedAt          DateTime?
  /// Why a person must look at it (not booked, mismatch, reported after payment).
  reviewReason         String?
  /// UNPAID/DISPUTED reported for an instruction already PAID: never moves it, never counts as an NPF.
  reportedAfterPayment Boolean                 @default(false)
  reviewResolvedAt     DateTime?
  reviewResolvedById   String?
  reviewNote           String?
  createdAt            DateTime                @default(now())

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  instruction      CollectionInstruction @relation(fields: [tenantId, instructionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payment          Payment?              @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewResolvedBy User?                 @relation("CollectionResultsResolved", fields: [tenantId, reviewResolvedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, provider, resultKey])
  @@index([tenantId, instructionId])
}
