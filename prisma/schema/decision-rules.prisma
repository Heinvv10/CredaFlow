// ── Business-configurable decisioning (lib/decisioning/) ─────────────────────
// Rule sets and scorecards are versioned, effective-dated and created only by
// an approved maker-checker change request (lib/maker-checker/): a version row
// cannot be inserted unless its ChangeRequest is APPROVED, and a version never
// changes. The engine config (mode, channels, products, challenger) is one row
// per lender, changed only through the same four-eyes route. Every automatic
// run is an append-only AutoDecisionRun (migration
// 20261029100100_decision_rules). Module rules: lib/decisioning/.claude.md.

/// OFF: the engine never runs (the default). SHADOW: it evaluates and records
/// a run but acts on nothing. LIVE: it also executes the verdict.
enum DecisionEngineMode {
  OFF
  SHADOW
  LIVE
}

enum AutoDecisionVerdict {
  APPROVE
  DECLINE
  REFER
}

enum AutoDecisionRole {
  CHAMPION
  CHALLENGER
}

/// What happened to the verdict. NOT_ACTED: shadow mode. REFERRED: the
/// application stays UNDER_REVIEW for staff (a REFER verdict, or an APPROVE
/// that a hard gate of the staff approval path refused).
enum AutoDecisionExecution {
  APPROVED
  DECLINED
  REFERRED
  NOT_ACTED
}

model DecisionRuleSetVersion {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  /// The product id this version governs, or "ALL" (a product's own set wins).
  scopeKey        String
  productId       String?
  product         LoanProduct? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  version         Int
  name            String
  /// RuleDef[] (lib/decisioning/types.ts), validated before approval.
  rules           Json
  /// Scorecard (lib/decisioning/types.ts), or null: the set then grades nothing.
  scorecard       Json?
  /// First SAST calendar day the version runs as champion.
  effectiveFrom   DateTime     @db.Date
  /// Never champion: it runs only as the lender's challenger.
  challengerOnly  Boolean      @default(false)
  /// The approved ChangeRequest that created it. No relation, so a consumer of
  /// lib/maker-checker/ adds nothing to ChangeRequest; the insert trigger
  /// (guardDecisionRuleSetVersion) requires it to exist, APPROVED, of this kind.
  changeRequestId String
  createdAt       DateTime     @default(now())

  // Back-relations: alphabetical, one per line (prisma/schema-order.test.ts).
  autoDecisionRuns         AutoDecisionRun[]
  engineConfigsChallenging DecisionEngineConfig[] @relation("DecisionEngineChallenger")

  @@unique([tenantId, id])
  @@unique([tenantId, scopeKey, version])
  @@unique([tenantId, changeRequestId])
  @@index([tenantId, scopeKey, effectiveFrom])
}

model DecisionEngineConfig {
  id                  String                  @id @default(cuid())
  tenantId            String                  @unique
  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  mode                DecisionEngineMode      @default(OFF)
  /// PORTAL, STAFF (lib/decisioning/facts.ts CHANNELS). Empty: no channel.
  channels            String[]
  /// Product ids the engine may decide. Empty: no product.
  productIds          String[]
  /// The staff user an automatic approval is booked under (LOAN_ADMIN or above; CHECK: LIVE needs one).
  delegateUserId      String?
  delegateUser        User?                   @relation("DecisionEngineDelegate", fields: [tenantId, delegateUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  repaymentMethod     LoanRepaymentMethod     @default(EFT)
  challengerVersionId String?
  challengerVersion   DecisionRuleSetVersion? @relation("DecisionEngineChallenger", fields: [tenantId, challengerVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// 0..50: the share of applications the challenger decides.
  challengerPercent   Int                     @default(0)
  updatedAt           DateTime                @updatedAt
  createdAt           DateTime                @default(now())

  @@unique([tenantId, id])
}

model AutoDecisionRun {
  id               String                  @id @default(cuid())
  tenantId         String
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  applicationId    String
  ruleSetVersionId String
  ruleSetVersion   DecisionRuleSetVersion @relation(fields: [tenantId, ruleSetVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role             AutoDecisionRole
  mode             DecisionEngineMode
  /// What started the run (lib/decisioning/auto-decision.ts TRIGGERS).
  trigger          String
  verdict          AutoDecisionVerdict
  /// string[]: every reason code behind the verdict (rule codes, gate codes).
  reasonCodes      Json
  riskGrade        String?
  score            Int?
  execution        AutoDecisionExecution
  /// Staff-only context: the staff-path gate message that turned an APPROVE into a referral.
  executionNote    String?
  latencyMs        Int
  createdAt        DateTime                @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, applicationId])
  @@index([tenantId, createdAt])
}
