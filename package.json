{
  "name": "credaflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:registries": "tsx scripts/gen-registries.ts",
    "postinstall": "test ! -f scripts/gen-registries.ts || tsx scripts/gen-registries.ts",
    "predev": "npm run --silent gen:registries",
    "dev": "next dev",
    "prebuild": "npm run --silent gen:registries",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "npm run --silent gen:registries",
    "test": "vitest run",
    "typecheck": "npm run --silent gen:registries && tsc --noEmit",
    "ci:quick": "bash scripts/ci-local.sh quick",
    "ci:quality": "bash scripts/ci-local.sh quality",
    "ci:integration": "bash scripts/ci-local.sh integration",
    "ci:full": "bash scripts/ci-local.sh full",
    "seed:base": "npm run --silent gen:registries && tsx prisma/seed.ts",
    "seed:staging": "npm run --silent gen:registries && tsx prisma/seed.ts && tsx prisma/seed-staging.ts",
    "claude-md:check": "tsx scripts/check-claude-md-paths.ts",
    "agents:mirror": "tsx scripts/mirror-agents-md.ts",
    "agents:check": "tsx scripts/mirror-agents-md.ts --check",
    "audit:security": "npm audit --audit-level=moderate",
    "db:drift": "node scripts/ops/check-db-enforcement-drift.mjs",
    "test:tz": "for z in UTC Africa/Johannesburg America/New_York Pacific/Kiritimati; do echo \"-- TZ=$z\"; TZ=$z vitest run --config vitest.tz.config.ts lib/date/ || exit 1; done",
    "dates:check": "tsx scripts/check-date-boundaries.ts",
    "face-models:fetch": "tsx scripts/fetch-face-models.ts",
    "lender:bootstrap-tenant": "npm run --silent gen:registries && tsx scripts/lender/bootstrap-tenant-cli.ts",
    "lender:set-jurisdiction": "npm run --silent gen:registries && tsx scripts/lender/set-instance-jurisdiction-cli.ts",
    "lender:set-exit-date": "npm run --silent gen:registries && tsx scripts/lender/set-exit-date-cli.ts",
    "lender:bootstrap-admin": "npm run --silent gen:registries && tsx scripts/lender/bootstrap-admin-cli.ts",
    "uploads:encrypt": "npm run --silent gen:registries && tsx scripts/encrypt-uploads-cli.ts",
    "demo:typecheck": "npm run --silent gen:registries && tsc --noEmit -p scripts/demo/tsconfig.json"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "npm run --silent seed:staging"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@node-saml/node-saml": "5.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "imapflow": "^1.2.18",
    "jose": "6.2.12",
    "lucide-react": "^1.7.0",
    "mailparser": "^3.9.39",
    "next": "^16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.1.1",
    "onnxruntime-node": "^1.30.0",
    "openid-client": "6.8.8",
    "pdf-lib": "^1.17.1",
    "prom-client": "15.1.3",
    "puppeteer": "^25.14.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^29.1.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prisma": "^5.22.0",
    "react-test-renderer": "^19.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "8.5.30"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.0"
  }
}
