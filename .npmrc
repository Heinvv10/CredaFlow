# The face comparison runs onnxruntime-node on the CPU only. Its postinstall
# otherwise downloads ~270MB of CUDA providers on linux/x64 that nothing
# loads. Read by onnxruntime-node/script/install-utils.js as
# npm_config_onnxruntime_node_install. The Dockerfile sets the same switch
# as ONNXRUNTIME_NODE_INSTALL (its deps stage does not copy this file).
onnxruntime-node-install=skip
