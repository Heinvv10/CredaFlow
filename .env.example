# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lms?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-using-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3300"

# Deployment hosts (lib/config/deployment-urls.ts). No defaults: anything that
# builds a link against an unset value throws rather than guessing a host.
# Lender identity (legal name, NCR/FSP/company numbers, contact details) is NOT
# env: an ADMIN enters it in Settings → Lender identity.
NEXT_PUBLIC_TENANT_SLUG=                 # this deployment's Tenant.slug
NEXT_PUBLIC_PORTAL_URL=                  # e.g. https://portal.lender.example
NEXT_PUBLIC_WEBSITE_URL=                 # marketing site origin, for agent referral links
TENANT_HOST_MAP=                         # host=slug,host=slug for every 3+-label host served
STAFF_APP_HOST=                          # staff workspace host; its "/" goes to /login
OPERATOR_APP_HOST=                       # operator console host (/operator); unset = no operator sign-in
EMAIL_INTERNAL_DOMAINS=                  # non-prod recipient guard: internal domains (comma-separated)
NEXT_PUBLIC_MATOMO_BLOCKED_HOSTS=        # hosts that must never send analytics (e.g. staging)
SMTP_FROM_NAME=                          # sender name for the staff password-reset email
WA_SENDER_URL=                           # WhatsApp sender service; unset = WhatsApp sends fail closed

# Stitch Payments
STITCH_CLIENT_ID=your-stitch-client-id
STITCH_CLIENT_SECRET=your-stitch-client-secret
STITCH_REDIRECT_URL=https://yourdomain.co.za/portal/payment/callback
# All required, no defaults (lib/stitch.ts). The portal EFT panel shows only
# when bank name, account number, branch code and account type are all set.
STITCH_BENEFICIARY_NAME=your-registered-legal-name
STITCH_BANK_ID=your-stitch-bank-id
STITCH_BANK_NAME=your-bank-name
STITCH_ACCOUNT_NUMBER=your-collection-account-number
STITCH_ACCOUNT_TYPE=your-account-type
DEBIT_MANDATE_CREDITOR_BANK_NAME=your-debit-order-collection-bank
DEBIT_MANDATE_CREDITOR_ACCOUNT_NUMBER=your-debit-order-collection-account-number
DEBIT_MANDATE_CREDITOR_BRANCH_CODE=your-debit-order-collection-branch-code
# Exact Tenant.id that owns the globally configured creditor identity/account.
# No default: debit-mandate generation fails closed unless this is configured.
DEBIT_MANDATE_CREDITOR_TENANT_ID=your-creditor-tenant-id
STITCH_BRANCH_CODE=your-branch-code
STITCH_WEBHOOK_SECRET=your-stitch-webhook-secret
# Slug of the ONE tenant the STITCH_*, SMILE_IDENTITY_* and EXPERIAN_* credentials
# in this file belong to (lib/integrations/tenant-credentials.ts). Other tenants
# use their own sealed TenantConfig credentials. Unset = the env credentials serve
# no one (the app logs a warning). provision-lender.sh sets it on a dedicated stack.
# Never reuse this slug for another tenant: whoever holds it gets these accounts.
ENV_CREDENTIALS_TENANT_SLUG=your-lender-slug

# VLM — Vision Language Model
VLM_MODEL=your-vlm-model-id
VLM_API_URL=http://localhost:8100
# Hosted OpenAI-compatible endpoint: dev/demo stacks with synthetic data only, never a real lender
# (POPIA). Needs an https VLM_API_URL and VLM_ALLOW_HOSTED=true; the self-hosted server needs neither.
VLM_API_KEY=
VLM_ALLOW_HOSTED=

# Face comparison (selfie vs ID photo): YuNet + SFace ONNX files, fetched with
# `npm run face-models:fetch` and checksum-verified on load. Unset = ./face-models
# under the working directory (/app/face-models in the Docker image). Missing or
# altered files fail every selfie check closed.
FACE_MODEL_DIR=

# Internal security
INTERNAL_API_SECRET=generate-with-openssl-rand-hex-32
CRON_SECRET=generate-with-openssl-rand-hex-32

# Compliance containment: keep false until insurance election + exact premium
# are captured before the PASQ is generated and acknowledged.
CREDIT_LIFE_AUTO_BUNDLE_ENABLED=false

# Cloudflare Turnstile (bot defence on public website forms)
# Register a site at https://dash.cloudflare.com/?to=/:account/turnstile
# In dev, leave both blank — the widget renders a placeholder and the server
# bypasses verification (with a one-time warning).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Website AI chat (lib/website-chat). Chat is OFF unless all THREE below are
# set AND Settings → WhatsApp → Chatbots is on (it defaults to on).
# TRUSTED_PROXY is the number of proxies in front of the app (see callerIp in
# lib/rate-limit.ts; 1 behind a single reverse proxy). Without it every caller's
# IP is "unknown", the chat's per-IP start limits cannot work, so the chat stays off.
# All must go in the file docker-compose's `env_file` reads — `.env.production`
# on staging and prod. A value only in `.env` never reaches the container.
ANTHROPIC_API_KEY=
WEBSITE_CHAT_SECRET= # 32+ random chars: openssl rand -base64 48
TRUSTED_PROXY=

# Website analytics (public marketing site)
# Matomo is the first-party analytics layer. Use the base tracker URL only.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# Google Tag Manager container for GA4 / Google Ads / Meta / LinkedIn tags.
# Leave blank until the GTM container is created and approved for production.
NEXT_PUBLIC_GTM_ID=

# PostHog self-hosted analytics for funnels, events, and session replay.
# Keep blank until posthog.example.com has public DNS + HTTPS.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# FSP Solutions QuickQuote — short-term insurance comparison embed.
#
# All six values are required together. Any one missing (or the flag not
# exactly "true") takes the whole surface down: the marketing section is not
# rendered and the quote host 404s. This is deliberate — FSP's script defaults
# its lead mailbox to itteam@fspsolutions.com, so a partially configured embed
# quotes normally while mailing every lead to FSP's IT team.
#
# NOT SECRETS. FSP's widget is browser-side, so EBC / ELEAD / BROKER_EMAIL /
# BROKER_NAME are serialised into the HTML of a public page and readable by
# anyone who loads it. That is inherent to the vendor. They are broker
# identifiers, not credentials: do not treat them as rotatable secrets, and do
# not assume rotating them undoes an exposure. Ask FSP what actually binds them
# to our domain.
#
# Leave blank until the signed usage contract, the POPIA operator agreement and
# the written insurer-panel confirmation are all in hand.
#
# NOTE: these are read at request time, so both pages are force-dynamic. Setting
# them requires a container restart, not a rebuild.
FSP_QUICKQUOTE_ENABLED=false
FSP_QUICKQUOTE_EBC=
FSP_QUICKQUOTE_ELEAD=
FSP_QUICKQUOTE_BROKER_EMAIL=
FSP_QUICKQUOTE_BROKER_NAME=
# Origin of the isolated host that renders the widget. Must be https AND its
# host must appear in FSP_QUICKQUOTE_HOSTS below (lib/insurance/quickquote-config.ts) —
# an allow-list, so pointing this at one of our own session-bearing origins is
# refused rather than silently accepted. FSP's bundle ships jQuery 1.9.1 and
# executes their JSONP in whichever origin loads it.
#
# The host also needs DNS + TLS + an nginx vhost proxying to the same container.
# FSP_QUICKQUOTE_EMBED_ORIGIN=https://quote.example.com
#
# Quote-host allow-list and framing origins. NO defaults: unset means the quote
# host is OFF (the host check fails for every hostname and frame-ancestors adds
# nothing). Malformed entries are ignored.
#   FSP_QUICKQUOTE_HOSTS            comma-separated bare hostnames that may serve /quote
#   FSP_QUICKQUOTE_FRAME_ANCESTORS  comma-separated https origins (no path) allowed to frame it
# frame-ancestors is baked into the build's response headers, so set
# FSP_QUICKQUOTE_FRAME_ANCESTORS at BUILD time as well as at runtime.
# FSP_QUICKQUOTE_HOSTS=quote.example.com
# FSP_QUICKQUOTE_FRAME_ANCESTORS=https://www.example.com

# Narrows who gets paged by the WhatsApp bridge outage alert
# (app/api/cron/check-wa-bridge-status). Comma-separated addresses, matched
# case-insensitively. Unset = every active ADMIN/SUPER_ADMIN, which is the
# default everywhere else.
#
# This NARROWS the admin query rather than replacing it: an address here that
# is not an active ADMIN/SUPER_ADMIN receives nothing, so it cannot be used to
# subscribe a non-staff mailbox to infrastructure alerts. Read at request time
# — changing it needs a container restart, not a rebuild.
WA_BRIDGE_ALERT_RECIPIENTS=

# Xero accounting export (lib/accounting/xero). Unset = Xero is not offered.
# XERO_REDIRECT_URI is the staff host's /api/integrations/xero/callback and
# must be registered on the Xero developer app. Tokens are sealed with WABA_ENC_KEY.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=
# XERO_SCOPES=offline_access accounting.transactions accounting.settings.read

# IsaFlow draft-journal push (lib/accounting/isaflow). Comma-separated IsaFlow
# origins a lender may connect to; unset = IsaFlow is not offered. https only;
# an http loopback origin (the fake, scripts/fake-isaflow.ts) is accepted only
# under NODE_ENV development or test. Tokens are sealed with WABA_ENC_KEY.
# ISAFLOW_ALLOWED_ORIGINS=https://app.isaflow.co.za

# Signs webhooks of the simulated payout channel (lib/payouts/providers/simulated.ts).
# SIMULATED_PAYOUT_WEBHOOK_SECRET=
